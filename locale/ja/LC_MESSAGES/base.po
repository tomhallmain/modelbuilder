#: mb/cli/parsing/data.py:18
msgid "Data processing operations"
msgstr "データ処理の操作"

#: mb/cli/parsing/data.py:19
msgid "Data processing operations for preparing image datasets"
msgstr "画像データセットを準備するためのデータ処理操作"

#: mb/cli/parsing/data.py:23
msgid "Data subcommands"
msgstr "データのサブコマンド"

#: mb/cli/parsing/data.py:30
msgid "Gather images from source directories"
msgstr "ソースディレクトリから画像を収集"

#: mb/cli/parsing/data.py:32
msgid ""
"Gather images from source directories into a target directory, with "
"deduplication and optional weighting by subdirectory."
msgstr "ソースディレクトリの画像を対象ディレクトリに収集します。重複を除き、サブディレクトリごとに重みを付けることもできます。"

#: mb/cli/parsing/data.py:40
msgid "Source directory containing images"
msgstr "画像があるソースディレクトリ"

#: mb/cli/parsing/data.py:46
msgid "Subdirectories to process"
msgstr "処理するサブディレクトリ"

#: mb/cli/parsing/data.py:53
msgid ""
"Target number of images to gather (default: from pipeline "
"data.gather.default_target_count). Treated as a limit, not an exact "
"requirement."
msgstr ""
"収集する画像の目標数 (既定値: パイプラインの "
"data.gather.default_target_count)。正確な件数ではなく上限として扱います。"

#: mb/cli/parsing/data.py:61
msgid ""
"Target directory for gathered images (default: from pipeline "
"data.gather.default_target_dir)"
msgstr "収集した画像の対象ディレクトリ (既定値: パイプラインの data.gather.default_target_dir)"

#: mb/cli/parsing/data.py:67
msgid ""
"Rejected directory for manually rejected images (default: "
"data.gather.default_rejected_dir)"
msgstr "手動で却下した画像の却下ディレクトリ (既定値: data.gather.default_rejected_dir)"

#: mb/cli/parsing/data.py:73
msgid ""
"Relative weights for subdirectories: \"subdir1:weight1,subdir2:weight2\" "
"(e.g. \"neutral:4,drawing:1\" ≈ 80%%/20%%, or \"neutral:0.8,drawing:0.2\"). "
"Weights are normalized automatically; any positive numbers work."
msgstr ""
"サブディレクトリの相対重み: \"subdir1:weight1,subdir2:weight2\" (例: "
"\"neutral:4,drawing:1\" ~ 80%%/20%%、または "
"\"neutral:0.8,drawing:0.2\")。重みは自動で正規化されます。正の数ならどれでも使えます。"

#: mb/cli/parsing/data.py:82
msgid ""
"Root directory for raw data (default: data.raw_data_dir in pipeline config)"
msgstr "生データのルートディレクトリ (既定値: パイプライン設定の data.raw_data_dir)"

#: mb/cli/parsing/data.py:89
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, gather also considers configured video extensions."
msgstr ""
"パイプラインのモデル種別 (既定値: model.default_type)。image_classification "
"の場合、収集では設定済みの動画拡張子も対象になります。"

#: mb/cli/parsing/data.py:97
msgid "Convert images to specified format"
msgstr "画像を指定の形式に変換"

#: mb/cli/parsing/data.py:99
msgid ""
"Convert images in the raw data directory to a specified format (e.g., JPEG)."
" Large images are automatically resized to prevent memory issues."
msgstr ""
"生データディレクトリ内の画像を指定の形式 (例: JPEG) に変換します。メモリ不足を防ぐため、大きな画像は自動的にサイズが調整されます。"

#: mb/cli/parsing/data.py:107 mb/cli/parsing/data.py:194
#: mb/cli/parsing/data.py:220 mb/cli/parsing/data.py:413
msgid "Raw data directory (default: raw_data)"
msgstr "生データのディレクトリ（デフォルト: raw_data）"

#: mb/cli/parsing/data.py:114
msgid ""
"Target format for converted outputs (default: jpeg). The converter is "
"currently JPEG-oriented; non-default values may be ignored until "
"implemented."
msgstr ""
"変換後の出力の対象形式（デフォルト: jpeg）。現在の変換処理は JPEG 向けであり、デフォルト以外の値は実装されるまで無視されることがあります。"

#: mb/cli/parsing/data.py:123
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, videos and multi-frame GIFs get a random frame as "
"JPEG."
msgstr ""
"パイプラインのモデル種別（デフォルト: model.default_type）。image_classification の場合、動画と複数フレームの "
"GIF は無作為な 1 フレームを JPEG として得ます。"

#: mb/cli/parsing/data.py:131
msgid ""
"Allow convert to run even if the raw-data drive appears to have insufficient"
" free space (heuristic estimate; not recommended)."
msgstr "生データ用ドライブの空き容量が不足しているように見えても convert の実行を許可します（ヒューリスティックな見積もり。非推奨）。"

#: mb/cli/parsing/data.py:140
msgid ""
"Unified snapshot run ID to update (snapshot_<run_id>.json under raw data). "
"Omit to start a new snapshot with a new run ID."
msgstr ""
"更新する統合スナップショットの実行 ID（生データ配下の snapshot_<run_id>.json）。省略すると、新しい実行 ID "
"で新しいスナップショットを開始します。"

#: mb/cli/parsing/data.py:148
msgid "Remove duplicate images"
msgstr "重複画像を削除"

#: mb/cli/parsing/data.py:150
msgid ""
"Remove duplicate images within and across class directories. Uses perceptual"
" hashing to identify duplicates and moves them to a review directory."
msgstr "クラスのディレクトリ内およびディレクトリ間で重複画像を削除します。知覚ハッシュで重複を特定し、確認用ディレクトリへ移動します。"

#: mb/cli/parsing/data.py:159
msgid ""
"Root raw data directory containing class subdirectories (default: raw_data)."
" Typical layouts include multiple class folders under this root."
msgstr ""
"クラスのサブディレクトリを含む生データのルートディレクトリ（デフォルト: "
"raw_data）。典型的な配置では、このルートの下に複数のクラスフォルダーがあります。"

#: mb/cli/parsing/data.py:167
msgid ""
"Scan and print duplicate groups as indented JSON (no removals). Useful for "
"manual review workflows."
msgstr "重複グループをインデント付き JSON として走査して表示します（削除はしません）。手動確認の手順に便利です。"

#: mb/cli/parsing/data.py:176
msgid ""
"Optional unified snapshot run ID to update with deduplication metadata. If "
"omitted, the latest loadable snapshot under raw data is used when available."
msgstr ""
"重複排除のメタデータで更新する、任意の統合スナップショット実行 "
"ID。省略したときは、利用できる場合、生データ配下で読み込める最新のスナップショットを使います。"

#: mb/cli/parsing/data.py:184
msgid "Upscale small images"
msgstr "小さい画像を拡大"

#: mb/cli/parsing/data.py:186
msgid ""
"Upscale images that are smaller than a minimum dimension threshold. Small "
"images are moved to a review directory for manual inspection before "
"upscaling."
msgstr "最小寸法のしきい値より小さい画像を拡大します。小さい画像は、拡大の前に手動確認のため確認用ディレクトリへ移されます。"

#: mb/cli/parsing/data.py:200
msgid ""
"Review directory containing small images to upscale (default: <raw-data-"
"dir>/small_images_review). Upscaled outputs go under <review-"
"dir>/upscaled_small_images."
msgstr ""
"拡大する小さい画像がある確認用ディレクトリ（デフォルト: <raw-data-dir>/small_images_review）。拡大後の出力は "
"<review-dir>/upscaled_small_images の下に置かれます。"

#: mb/cli/parsing/data.py:209
msgid "Create train/test dataset splits"
msgstr "学習/テストのデータセット分割を作成"

#: mb/cli/parsing/data.py:211
msgid ""
"Create training and test dataset splits from raw data. Validates images, "
"removes corrupted files, filters by size, and creates balanced train/test "
"splits with hash-based filenames."
msgstr ""
"生データから学習用とテスト用のデータセット分割を作成します。画像を検証し、破損したファイルを除き、寸法で絞り込み、ハッシュに基づくファイル名で均衡の取れた学習/テスト分割を作成します。"

#: mb/cli/parsing/data.py:226
msgid "Output data directory (default: data)"
msgstr "出力データのディレクトリ（デフォルト: data）"

#: mb/cli/parsing/data.py:233
msgid ""
"Number of items per class in the test split when mode is fixed; also the "
"anchor for dataset-weighted mode (default: data.test_per_class from pipeline"
" YAML)."
msgstr ""
"モードが fixed のとき、テスト分割のクラスごとの項目数。dataset-weighted モードのアンカーでもあります（デフォルト: パイプライン"
" YAML の data.test_per_class）。"

#: mb/cli/parsing/data.py:242
msgid ""
"fixed = test_per_class images per class; dataset-weighted = modulated counts"
" from class size vs total (default: data.test_split_mode in pipeline YAML, "
"else fixed)."
msgstr ""
"fixed = クラスごとに test_per_class 枚。dataset-weighted = "
"クラスの大きさの全体に対する割合から調整した枚数（デフォルト: パイプライン YAML の data.test_split_mode、未設定時は "
"fixed）。"

#: mb/cli/parsing/data.py:251
msgid ""
"With dataset-weighted mode: classes with fewer images than this use a "
"proportional test count; larger classes use anchor + anchor×(class_share). "
"Omit to use --test-per-class as the threshold (default: pipeline "
"data.test_small_class_threshold)."
msgstr ""
"dataset-weighted モードでは、画像数がこれより少ないクラスは比例したテスト数を使い、より大きいクラスはアンカー + アンカー x "
"(class_share) を使います。省略するとしきい値に --test-per-class を使います（デフォルト: パイプラインの "
"data.test_small_class_threshold）。"

#: mb/cli/parsing/data.py:261
msgid ""
"Random seed for reproducibility (default: data.seed from pipeline YAML when "
"set, else non-deterministic)"
msgstr "再現性のための乱数シード（設定されている場合のデフォルト: パイプライン YAML の data.seed、未設定時は非決定的）"

#: mb/cli/parsing/data.py:267 mb/cli/parsing/train.py:231
msgid ""
"Run ID of unified snapshot to update (auto-detects latest if not provided)"
msgstr "更新する統合スナップショットの実行 ID（未指定時は最新を自動検出）"

#: mb/cli/parsing/data.py:273
msgid ""
"Balance the training set to the smallest class size (default: off, keeps "
"natural proportions)."
msgstr "学習セットを最も小さいクラスのサイズに揃えます（デフォルト: off、自然な比率を維持）。"

#: mb/cli/parsing/data.py:280
msgid ""
"Maximum training items per class (no limit if omitted; keeps natural "
"proportions below the cap)."
msgstr "クラスごとの学習項目の上限（省略時は制限なし。上限未満では自然な比率を維持します）。"

#: mb/cli/parsing/data.py:286
msgid "Allow running on external/removable storage (not recommended)"
msgstr "外部またはリムーバブルのストレージでの実行を許可（非推奨）"

#: mb/cli/parsing/data.py:292
msgid ""
"Allow create-dataset even if the output data drive appears to have "
"insufficient free space (heuristic estimate; not recommended)."
msgstr ""
"出力データ用ドライブの空き容量が不足しているように見えても create-dataset を許可します（ヒューリスティックな見積もり。非推奨）。"

#: mb/cli/parsing/data.py:301
msgid ""
"Pipeline model type (default: model.default_type). image_classification "
"builds train/test ImageFolder splits from class subdirectories (all other "
"options above apply); image_generation_lora instead copies every image "
"directly under --raw-data-dir (no class folders, no train/test split) plus "
"its optional .txt caption sidecar into --data-dir, for LoRA fine-tuning of "
"an image-generation model."
msgstr ""
"パイプラインのモデル種別（デフォルト: model.default_type）。image_classification "
"はクラスのサブディレクトリから学習/テストの ImageFolder "
"分割を作ります（上記の他のオプションはすべて適用されます）。image_generation_lora は代わりに、--raw-data-dir "
"の直下にある各画像を（クラスフォルダーも学習/テスト分割もなく）任意の併置 .txt キャプションとともに --data-dir "
"へコピーし、画像生成モデルの LoRA 微調整に使います。"

#: mb/cli/parsing/data.py:312
msgid "Rename mislabeled .jpg sources and rebuild CONVERTED JPEGs"
msgstr "誤ったラベルの .jpg ソースを改名し、CONVERTED の JPEG を再構築"

#: mb/cli/parsing/data.py:314
msgid ""
"Finds non-JPEG bytes under .jpg/.jpeg names in class source trees (same "
"discovery as convert), writes corrected JPEGs, and removes stale copies "
"under CONVERTED and small_images_review only after a successful write. "
"Animated GIFs use the same random-frame + visual_media_review layout as "
"convert when the model type is image_classification."
msgstr ""
"クラスのソースツリーで .jpg/.jpeg という名前の下にある JPEG 以外のバイトを見つけ（見つけ方は convert と同じ）、修正した "
"JPEG を書き、書き込みが成功した後にだけ CONVERTED と small_images_review の下の古いコピーを削除します。モデル種別が"
" image_classification のとき、アニメーション GIF は convert と同じ無作為フレーム + "
"visual_media_review の配置を使います。"

#: mb/cli/parsing/data.py:325
msgid ""
"Raw data directory (default: data.raw_data_dir from the pipeline config "
"after --config; same as gather/convert when omitted)."
msgstr ""
"生データのディレクトリ（デフォルト: --config の後のパイプライン設定にある data.raw_data_dir。省略時は "
"gather/convert と同じ）。"

#: mb/cli/parsing/data.py:332
msgid "Log planned repairs only; do not rename files or write outputs."
msgstr "予定した修復だけを記録し、ファイルの改名や出力の書き込みは行いません。"

#: mb/cli/parsing/data.py:339
msgid ""
"Print newline-delimited JSON (stdout): dry-run or live repair. By default "
"only actionable mismatches are listed; use -v to include policy-skipped "
"PNG/WebP/BMP/TIFF under .jpg. Live repair emits one line per successful fix "
"when applicable."
msgstr ""
"改行区切りの JSON を出力します（stdout）。ドライランまたは本修復です。既定では対処できる不一致だけを列挙します。-v "
"を付けると、方針によりスキップした .jpg 配下の PNG/WebP/BMP/TIFF も含めます。本修復では、該当する場合、成功した修正ごとに 1 "
"行を出します。"

#: mb/cli/parsing/data.py:348
msgid ""
"With --dry-run and --json: include Pillow format and GIF metadata in each "
"JSON object."
msgstr ""
"--dry-run と --json を付けた場合: 各 JSON オブジェクトに Pillow の形式と GIF のメタデータを含めます。"

#: mb/cli/parsing/data.py:355
msgid ""
"With --dry-run: omit verbose per-file log lines (use with --json for "
"machine-readable output only)."
msgstr "--dry-run の場合: ファイルごとの詳しいログ行を省きます（機械が読める出力だけにするには --json と併用します）。"

#: mb/cli/parsing/data.py:364
msgid ""
"With --json: include policy-skipped static-format mismatches in JSON output."
" In text mode: log each policy-skipped file and class progress for every "
"folder; with live repair, log each skipped file. Useless with --quiet. "
"Separate from top-level mb -v (global logging)."
msgstr ""
"--json の場合: 方針によりスキップした静的形式の不一致を JSON "
"出力に含めます。テキストモードでは、方針によりスキップした各ファイルと、フォルダーごとのクラスの進行状況を記録します。本修復では、スキップした各ファイルを記録します。--quiet"
" と併用しても意味がありません。最上位の mb -v（グローバルなログ）とは別です。"

#: mb/cli/parsing/data.py:374
msgid ""
"Also rename/repair mislabeled .jpg/.jpeg whose bytes are PNG, WebP, BMP, or "
"TIFF. By default those are counted and summarized per class only (GIF and "
"animated-IC cases are always repaired)."
msgstr ""
"バイト列が PNG、WebP、BMP、TIFF である、誤ったラベルの .jpg/.jpeg "
"も改名または修復します。既定ではクラスごとに件数と要約だけを出します（GIF と animated-IC は常に修復されます）。"

#: mb/cli/parsing/data.py:382
msgid "Pipeline model type (default: model.default_type)."
msgstr "パイプラインのモデル種別（デフォルト: model.default_type）。"

#: mb/cli/parsing/data.py:388
msgid "RNG seed for random GIF frame selection (optional)."
msgstr "GIF フレームを無作為に選ぶためのシード（省略可能）。"

#: mb/cli/parsing/data.py:394
msgid "Estimate disk space needed for convert or create-dataset"
msgstr "convert または create-dataset に必要なディスク容量を見積もる"

#: mb/cli/parsing/data.py:396
msgid ""
"Walks source files (same rules as convert/dataset) and compares a rough byte"
" estimate to free space on the target volume. Exits non-zero if the estimate"
" exceeds free space."
msgstr ""
"ソースファイルを走査し（規則は convert/dataset "
"と同じ）、おおまかなバイト見積もりを対象ボリュームの空き容量と比較します。見積もりが空き容量を超えると、ゼロ以外で終了します。"

#: mb/cli/parsing/data.py:407
msgid "Which step to estimate for"
msgstr "見積もる手順"

#: mb/cli/parsing/data.py:418
msgid "Output data directory (required when operation is create-dataset)"
msgstr "出力データのディレクトリ（操作が create-dataset のときは必須）"

#: mb/cli/parsing/evaluate.py:16
msgid "Evaluate trained models or datasets"
msgstr "学習済みモデルまたはデータセットを評価"

#: mb/cli/parsing/evaluate.py:18
msgid ""
"Score a trained classifier on your train/test tree, surface likely labeling "
"mistakes, or compare two checkpoints on the same data."
msgstr "学習/テストのツリーで学習済み分類器を採点し、ラベル付けの誤りらしいものを示し、または同じデータで 2 つのチェックポイントを比較します。"

#: mb/cli/parsing/evaluate.py:24
msgid "Evaluate subcommands"
msgstr "評価のサブコマンド"

#: mb/cli/parsing/evaluate.py:30
msgid "Compute classification metrics on a labeled split"
msgstr "ラベル付き分割で分類の指標を計算"

#: mb/cli/parsing/evaluate.py:32
msgid ""
"Accuracy, confusion matrix, and per-class counts on an ImageFolder-style "
"directory (class-named subfolders of images). PyTorch requires "
"--architecture and a .pth/.pt file."
msgstr ""
"ImageFolder 形式のディレクトリ（クラス名の付いた画像のサブフォルダー）での正解率、混同行列、クラスごとの件数。PyTorch には "
"--architecture と .pth/.pt ファイルが必要です。"

#: mb/cli/parsing/evaluate.py:40 mb/cli/parsing/evaluate.py:133
msgid "Path to trained model file (.pth / .pt / .h5 / .keras)"
msgstr "学習済みモデルファイルへのパス（.pth / .pt / .h5 / .keras）"

#: mb/cli/parsing/evaluate.py:46 mb/cli/parsing/evaluate.py:139
#: mb/cli/parsing/evaluate.py:234
msgid "ImageFolder root (e.g. .../test with one subfolder per class)"
msgstr "ImageFolder のルート（例: クラスごとにサブフォルダーが 1 つの .../test）"

#: mb/cli/parsing/evaluate.py:52 mb/cli/parsing/evaluate.py:145
msgid "Training framework (default: infer from file extension)"
msgstr "学習フレームワーク（デフォルト: ファイル拡張子から推定）"

#: mb/cli/parsing/evaluate.py:58 mb/cli/parsing/evaluate.py:151
msgid ""
"Model architecture id (required for PyTorch .pth checkpoints, e.g. resnet34)"
msgstr "モデルのアーキテクチャ ID（PyTorch の .pth チェックポイントでは必須。例: resnet34）"

#: mb/cli/parsing/evaluate.py:64 mb/cli/parsing/evaluate.py:157
#: mb/cli/parsing/evaluate.py:264
msgid "Override class count (default: infer from directory layout)"
msgstr "クラス数を上書き（デフォルト: ディレクトリ構成から推定）"

#: mb/cli/parsing/evaluate.py:70 mb/cli/parsing/evaluate.py:163
#: mb/cli/parsing/evaluate.py:270
msgid "Pipeline model type (default: image_classification)"
msgstr "パイプラインのモデル種別（デフォルト: image_classification）"

#: mb/cli/parsing/evaluate.py:76 mb/cli/parsing/evaluate.py:169
#: mb/cli/parsing/evaluate.py:276
msgid "Square input size (default: 224)"
msgstr "正方形の入力サイズ（デフォルト: 224）"

#: mb/cli/parsing/evaluate.py:82 mb/cli/parsing/evaluate.py:175
#: mb/cli/parsing/evaluate.py:282
msgid "Batch size (default: 32)"
msgstr "バッチサイズ（デフォルト: 32）"

#: mb/cli/parsing/evaluate.py:88 mb/cli/parsing/evaluate.py:181
#: mb/cli/parsing/evaluate.py:288
msgid "DataLoader workers for PyTorch (default: 0)"
msgstr "PyTorch の DataLoader ワーカー（デフォルト: 0）"

#: mb/cli/parsing/evaluate.py:94 mb/cli/parsing/evaluate.py:187
#: mb/cli/parsing/evaluate.py:294
msgid "PyTorch device override, e.g. cuda or cpu (default: auto)"
msgstr "PyTorch のデバイス上書き。例: cuda または cpu（デフォルト: auto）"

#: mb/cli/parsing/evaluate.py:101
msgid ""
"How the model's output is interpreted (default: single_label). multi_label "
"reads label_schema.json beside the dataset and reports per-label metrics "
"instead of accuracy and a confusion matrix."
msgstr ""
"モデル出力の解釈方法（デフォルト: single_label）。multi_label はデータセットの横にある label_schema.json "
"を読み、正解率と混同行列の代わりにラベルごとの指標を報告します。"

#: mb/cli/parsing/evaluate.py:110
msgid ""
"--label-mode multi_label only: pick the per-label threshold that maximizes "
"each label's F1 on this split and write it back to label_schema.json. A "
"post-hoc calibration step — never run this on the training split."
msgstr ""
"--label-mode multi_label のときだけ: この分割で各ラベルの F1 "
"が最大になるラベルごとのしきい値を選び、label_schema.json に書き戻します。事後の較正手順です。学習分割では決して実行しないでください。"

#: mb/cli/parsing/evaluate.py:118 mb/cli/parsing/evaluate.py:205
#: mb/cli/parsing/evaluate.py:315
msgid "Validate arguments and exit without running inference"
msgstr "引数を検証し、推論を実行せずに終了"

#: mb/cli/parsing/evaluate.py:123
msgid "List images whose predicted class differs from the folder label"
msgstr "予測クラスがフォルダーのラベルと異なる画像を一覧表示"

#: mb/cli/parsing/evaluate.py:125
msgid ""
"Compares model predictions to ImageFolder-style on-disk class folders to "
"surface label noise and borderline samples. Image classification only."
msgstr ""
"モデルの予測を、ディスク上の ImageFolder 形式のクラスフォルダーと比べ、ラベルのノイズと境界付近のサンプルを示します。画像分類のみです。"

#: mb/cli/parsing/evaluate.py:194
msgid ""
"Cap printed / exported misclassified rows (default: no cap; totals still "
"full)"
msgstr "表示または書き出す誤分類行の上限（デフォルト: 上限なし。合計は完全なまま）"

#: mb/cli/parsing/evaluate.py:200
msgid "Optional CSV path (still prints a summary to stdout)"
msgstr "任意の CSV パス（要約は引き続き stdout に出力します）"

#: mb/cli/parsing/evaluate.py:210
msgid ""
"Compare two models on the same labeled split (paired outcomes & "
"disagreements)"
msgstr "同じラベル付き分割で 2 つのモデルを比較（対の結果と不一致）"

#: mb/cli/parsing/evaluate.py:212
msgid ""
"Runs both checkpoints on the same ImageFolder split in lockstep: top-1 "
"accuracy each, a 2×2-style breakdown (both correct, only A, only B, both "
"wrong vs folder labels), and how often A and B disagree on the predicted "
"class. PyTorch and Keras supported when both files use the same framework."
msgstr ""
"同じ ImageFolder 分割で両方のチェックポイントを揃えて実行します。それぞれの top-1 正解率、2x2 形式の内訳（両方正解、A のみ、B"
" のみ、フォルダーのラベルに対して両方不正解）、および予測クラスで A と B "
"が食い違う頻度です。両方のファイルが同じフレームワークのとき、PyTorch と Keras に対応します。"

#: mb/cli/parsing/evaluate.py:222
msgid "Path to first model file (.pth / .pt / .h5 / .keras)"
msgstr "1 番目のモデルファイルへのパス（.pth / .pt / .h5 / .keras）"

#: mb/cli/parsing/evaluate.py:228
msgid "Path to second model file (.pth / .pt / .h5 / .keras)"
msgstr "2 番目のモデルファイルへのパス（.pth / .pt / .h5 / .keras）"

#: mb/cli/parsing/evaluate.py:240
msgid ""
"Training framework hint for both models (default: infer from each file)"
msgstr "両方のモデル向けの学習フレームワークのヒント（デフォルト: 各ファイルから推定）"

#: mb/cli/parsing/evaluate.py:246
msgid ""
"Optional framework hint for model B only (default: same as --framework)"
msgstr "モデル B だけに使う任意のフレームワークのヒント（デフォルト: --framework と同じ）"

#: mb/cli/parsing/evaluate.py:252
msgid "Model architecture id for PyTorch model A (e.g. resnet34)"
msgstr "PyTorch モデル A のアーキテクチャ ID（例: resnet34）"

#: mb/cli/parsing/evaluate.py:258
msgid ""
"Architecture for PyTorch model B when it differs from model A (default: "
"--architecture)"
msgstr "モデル A と異なるときの PyTorch モデル B のアーキテクチャ（デフォルト: --architecture）"

#: mb/cli/parsing/evaluate.py:302
msgid ""
"Cap printed / exported rows where A and B disagree on class (default: no "
"cap; totals still full)"
msgstr "A と B のクラスが一致しない、表示または書き出し行の上限（デフォルト: 上限なし。合計は完全なまま）"

#: mb/cli/parsing/evaluate.py:310
msgid ""
"Optional TSV path for disagreement rows (summary still prints to stdout)"
msgstr "不一致の行用の任意の TSV パス（要約は引き続き stdout に出力します）"

#: mb/cli/parsing/export.py:15
msgid "Export model bundle artifacts"
msgstr "モデルバンドルの成果物をエクスポート"

#: mb/cli/parsing/export.py:17
msgid ""
"Export deployment bundle artifacts such as safetensors weights and metadata "
"manifests."
msgstr "safetensors の重みやメタデータのマニフェストなど、配備用バンドルの成果物をエクスポートします。"

#: mb/cli/parsing/export.py:22
msgid "Export subcommands"
msgstr "エクスポートのサブコマンド"

#: mb/cli/parsing/export.py:28
msgid ""
"Export a model bundle (safetensors + manifest + optional architecture stub)"
msgstr "モデルバンドルをエクスポート（safetensors + マニフェスト + 任意のアーキテクチャスタブ）"

#: mb/cli/parsing/export.py:30
msgid "Input model file (.pth/.pt)"
msgstr "入力モデルファイル（.pth/.pt）"

#: mb/cli/parsing/export.py:31
msgid "Output bundle directory"
msgstr "出力バンドルのディレクトリ"

#: mb/cli/parsing/export.py:32
msgid "Model architecture id (e.g. resnet34)"
msgstr "モデルのアーキテクチャ ID（例: resnet34）"

#: mb/cli/parsing/export.py:33
msgid "Number of output classes"
msgstr "出力クラス数"

#: mb/cli/parsing/export.py:34
msgid "Optional ordered class names"
msgstr "任意の、順序付きクラス名"

#: mb/cli/parsing/export.py:35
msgid "Optional data dir to infer class names from train/"
msgstr "train/ からクラス名を推定するための任意のデータディレクトリ"

#: mb/cli/parsing/export.py:36
msgid "Expected input image size (defaults to pipeline)"
msgstr "想定する入力画像サイズ（デフォルトはパイプラインの値）"

#: mb/cli/parsing/export.py:37
msgid "Optional snapshot JSON path"
msgstr "任意のスナップショット JSON パス"

#: mb/cli/parsing/export.py:41
msgid "Do not emit model_architecture.py stub"
msgstr "model_architecture.py スタブを出力しない"

#: mb/cli/parsing/export.py:43
msgid "Optional run ID to include in manifest"
msgstr "マニフェストに入れる任意の実行 ID"

#: mb/cli/parsing/info.py:15
msgid "Show information about models or datasets"
msgstr "モデルまたはデータセットの情報を表示"

#: mb/cli/parsing/info.py:17
msgid ""
"Display information about trained models or datasets, including metadata, "
"architecture details, and dataset statistics."
msgstr "学習済みモデルまたはデータセットの情報を表示します。メタデータ、アーキテクチャの詳細、データセットの統計を含みます。"

#: mb/cli/parsing/info.py:23
msgid "Info subcommands"
msgstr "情報のサブコマンド"

#: mb/cli/parsing/info.py:30
msgid "Show model information"
msgstr "モデル情報を表示"

#: mb/cli/parsing/info.py:32
msgid ""
"Display detailed information about a trained model, including architecture, "
"framework, number of parameters, and training metadata."
msgstr "学習済みモデルの詳細を表示します。アーキテクチャ、フレームワーク、パラメータ数、学習のメタデータを含みます。"

#: mb/cli/parsing/info.py:40
msgid "Path to model file"
msgstr "モデルファイルへのパス"

#: mb/cli/parsing/info.py:46
msgid "Show dataset information"
msgstr "データセット情報を表示"

#: mb/cli/parsing/info.py:48
msgid ""
"Display statistics about a dataset, including class distributions, image "
"counts, and data directory structure."
msgstr "データセットの統計を表示します。クラスの分布、画像数、データディレクトリの構造を含みます。"

#: mb/cli/parsing/info.py:56
msgid "Path to data directory"
msgstr "データディレクトリへのパス"

#: mb/cli/parsing/model_convert.py:15
msgid "Convert model between formats"
msgstr "モデルを形式の間で変換"

#: mb/cli/parsing/model_convert.py:17
msgid ""
"Convert a trained model between different formats. Supports PyTorch -> ONNX,"
" PyTorch -> SafeTensors, and Keras -> ONNX."
msgstr ""
"学習済みモデルを別の形式へ変換します。PyTorch -> ONNX、PyTorch -> SafeTensors、Keras -> ONNX "
"に対応します。"

#: mb/cli/parsing/model_convert.py:25
msgid "Input model file"
msgstr "入力モデルファイル"

#: mb/cli/parsing/model_convert.py:31
msgid "Output model file"
msgstr "出力モデルファイル"

#: mb/cli/parsing/model_convert.py:36
msgid "Source framework (auto-detected if not specified)"
msgstr "変換元フレームワーク（指定がなければ自動検出）"

#: mb/cli/parsing/model_convert.py:42
msgid "Target format (onnx or safetensors)"
msgstr "対象形式（onnx または safetensors）"

#: mb/cli/parsing/model_convert.py:46
msgid ""
"Model architecture (required for PyTorch -> ONNX conversion, e.g., "
"'resnet34')"
msgstr "モデルのアーキテクチャ (PyTorch -> ONNX への変換に必須。例: 'resnet34')"

#: mb/cli/parsing/model_convert.py:51
msgid "Number of output classes (required for PyTorch -> ONNX conversion)"
msgstr "出力クラス数 (PyTorch -> ONNX への変換に必須)"

#: mb/cli/parsing/model_convert.py:57
msgid "Input image size (default: 224, used for ONNX conversion)"
msgstr "入力画像サイズ (既定: 224、ONNX 変換に使用)"

#: mb/cli/parsing/model_convert.py:63
msgid ""
"Class names in output-index order, recorded in the ONNX file's metadata so "
"consumers do not have to be told the label order separately"
msgstr "出力インデックス順のクラス名。ONNX ファイルのメタデータに記録されるため、利用側はラベル順を別途知らされる必要がありません"

#: mb/cli/parsing/model_convert.py:72
msgid ""
"Also write quantized ONNX variants alongside the output (e.g. --quantize "
"fp16 int8). Smaller and faster at some cost in accuracy — score them before "
"deploying."
msgstr ""
"量子化した ONNX バリアントも出力と並べて書き出します (例: --quantize fp16 "
"int8)。より小さくより速くなりますが、精度はいくらか落ちます - デプロイ前に評価してください。"

#: mb/cli/parsing/text.py:15
msgid "Text classification: verify data, evaluate, score, compare runs"
msgstr "テキスト分類：データを検証、評価、スコア付け、実行を比較"

#: mb/cli/parsing/text.py:17
msgid ""
"Operations on text-classification datasets and run directories. Train with "
"`mb train --model-type text_classification`; defaults come from the "
"pipeline's text_classification section."
msgstr ""
"テキスト分類データセットと実行ディレクトリの操作。`mb train --model-type "
"text_classification`でトレーニングします；デフォルトはパイプラインのtext_classificationセクションから取得されます。"

#: mb/cli/parsing/text.py:22
msgid "Text subcommands"
msgstr "テキストサブコマンド"

#: mb/cli/parsing/text.py:26
msgid "Check a dataset directory's integrity"
msgstr "データセットディレクトリの整合性をチェック"

#: mb/cli/parsing/text.py:28
msgid ""
"Compares file hashes and row/label/tier/split/group counts with "
"manifest.json (when present), and checks that texts are unique and each "
"group sits in one split. Exits non-zero on any failed check."
msgstr ""
"manifest.json（存在する場合）とファイルハッシュおよび行/ラベル/ティア/スプリット/グループ数を比較し、テキストがユニークで各グループが1つのスプリットにのみ属しているかをチェックします。チェックに失敗した場合は非ゼロで終了します。"

#: mb/cli/parsing/text.py:37
msgid "Dataset directory (default: text_classification.data_dir)"
msgstr "データセットディレクトリ（デフォルト: text_classification.data_dir）"

#: mb/cli/parsing/text.py:42
msgid "Re-run thresholds, metrics and reports for a run directory"
msgstr "実行ディレクトリのしきい値、メトリック、レポートを再実行"

#: mb/cli/parsing/text.py:44
msgid ""
"Reloads the run's model and calibrator, chooses thresholds on val gold, and "
"rewrites metrics.json, thresholds.json, predictions, review queue, unlabeled"
" scores, predict.py and the model card."
msgstr ""
"実行のモデルとキャリブレータをリロードし、検証ゴールドの閾値を選択し、metrics.json、thresholds.json、predictions、レビューキュー、未ラベルスコア、predict.py、モデルカードを上書きします。"

#: mb/cli/parsing/text.py:49 mb/cli/parsing/text.py:65
msgid "Run directory"
msgstr "ディレクトリを実行"

#: mb/cli/parsing/text.py:54
msgid "Dataset directory (default: the run's config.yaml)"
msgstr "データセットディレクトリ（デフォルト: 実行の config.yaml）"

#: mb/cli/parsing/text.py:56 mb/cli/parsing/text.py:68
msgid "Device override, e.g. cuda or cpu"
msgstr "デバイスオーバーライド、例：CUDA または CPU"

#: mb/cli/parsing/text.py:60
msgid "Score one string per line with a run's calibrated model"
msgstr "実行の較正済みモデルで、1行につき1文字列をスコア付けする"

#: mb/cli/parsing/text.py:62
msgid ""
"Writes term<TAB>score with a header, one row per input line in input order."
msgstr "ヘッダー付きで term<TAB>score を出力し、入力行ごとに1行ずつ、入力順に並べます。"

#: mb/cli/parsing/text.py:66
msgid "UTF-8 text file, one string per line"
msgstr "UTF-8 テキストファイル、1 行につき 1 文字列"

#: mb/cli/parsing/text.py:67
msgid "Output TSV path"
msgstr "TSV出力パス"

#: mb/cli/parsing/text.py:72
msgid "Tabulate headline metrics across run directories"
msgstr "実行ディレクトリ全体のヘッドライン指標を表にする"

#: mb/cli/parsing/text.py:74
msgid ""
"One row per run: test gold AP, full AP, recall at precision 0.90, gold "
"false-positive rate at the decision threshold and ECE. Wildcards are "
"expanded (e.g. data/models/text_runs/*)."
msgstr ""
"実行ごとに1行：テストゴールドAP、フルAP、精度0.90でのリコール、決定閾値でのゴールド偽陽性率、そしてECE。ワイルドカードは展開されます（例：data/models/text_runs/*）。"

#: mb/cli/parsing/text.py:79
msgid "Run directories or wildcard patterns"
msgstr "ディレクトリまたはワイルドカード パターンを実行"

#: mb/cli/parsing/train.py:17
msgid "Train a model"
msgstr "モデルを学習"

#: mb/cli/parsing/train.py:19
msgid ""
"Train a machine learning model using the specified framework and "
"architecture. Supports transfer learning with frozen/unfrozen training "
"phases."
msgstr "指定したフレームワークとアーキテクチャで機械学習モデルを学習します。凍結/非凍結の学習フェーズによる転移学習に対応します。"

#: mb/cli/parsing/train.py:27
msgid ""
"Model type (default: model.default_type from config, else "
"image_classification)"
msgstr ""
"モデルタイプ（デフォルト: config の model.default_type、そうでなければ image_classification）"

#: mb/cli/parsing/train.py:32
msgid "Framework to use (default: from config)"
msgstr "使用するフレームワーク (既定: 設定から)"

#: mb/cli/parsing/train.py:37
msgid ""
"Model architecture (e.g., resnet34). For --model-type image_generation_lora,"
" this instead names the base image-generation model to fine-tune (a local "
"path or hub id, e.g. a Stable Diffusion checkpoint)."
msgstr ""
"モデルのアーキテクチャ (例: resnet34)。--model-type image_generation_lora "
"では、微調整する画像生成ベースモデルの名前を代わりに指定します (ローカルパスまたは hub id。例: Stable Diffusion "
"のチェックポイント)。"

#: mb/cli/parsing/train.py:46
msgid ""
"Data directory (default: from config). For --model-type text_classification,"
" the directory holding dataset.tsv (default: text_classification.data_dir)."
msgstr ""
"データディレクトリ（デフォルト：設定から）。--model-type text_classification の場合、dataset.tsv "
"を格納しているディレクトリ（デフォルト：text_classification.data_dir）。"

#: mb/cli/parsing/train.py:54
msgid ""
"Output directory for models (default: from config). For --model-type "
"text_classification, the parent of the run directory (default: "
"text_classification.runs_dir)."
msgstr ""
"モデルの出力ディレクトリ（デフォルト：設定から）。--model-type が text_classification "
"の場合、実行ディレクトリの親ディレクトリ（デフォルト：text_classification.runs_dir）。"

#: mb/cli/parsing/train.py:62
msgid "Number of frozen training epochs (default: from config)"
msgstr "凍結学習のエポック数 (既定: 設定から)"

#: mb/cli/parsing/train.py:67
msgid "Number of unfrozen training epochs (default: from config)"
msgstr "非凍結学習のエポック数 (既定: 設定から)"

#: mb/cli/parsing/train.py:72
msgid "Learning rate for frozen phase (default: from config)"
msgstr "凍結フェーズの学習率 (既定: 設定から)"

#: mb/cli/parsing/train.py:77
msgid "Maximum learning rate for unfrozen phase (default: from config)"
msgstr "非凍結フェーズの最大学習率 (既定: 設定から)"

#: mb/cli/parsing/train.py:82
msgid "Minimum learning rate for unfrozen phase (default: from config)"
msgstr "非凍結フェーズの最小学習率 (既定: 設定から)"

#: mb/cli/parsing/train.py:88
msgid ""
"Batch size (default: from config or auto-detect). For --model-type "
"text_classification, overrides text_classification.optim.batch_size."
msgstr ""
"バッチサイズ（デフォルト: 設定または自動検出）。--model-type text_classification "
"の場合、text_classification.optim.batch_size を上書きします。"

#: mb/cli/parsing/train.py:96
msgid ""
"Image size (default: 224). For --model-type image_generation_lora, this is "
"the training resolution instead (default: 512)."
msgstr ""
"画像サイズ (既定: 224)。--model-type image_generation_lora では、代わりに学習解像度です (既定: 512)。"

#: mb/cli/parsing/train.py:103
msgid "Number of data loading workers (default: from config)"
msgstr "データ読み込みワーカー数 (既定: 設定から)"

#: mb/cli/parsing/train.py:109
msgid ""
"Whether an image carries one class or several (image_classification only; "
"default: from config, which ships as single_label). multi_label reads "
"label_schema.json and labels.jsonl beside the dataset and trains independent"
" per-label sigmoids. PyTorch only."
msgstr ""
"画像が持つクラスが1つか複数か (image_classification のみ。既定: 設定から。出荷時は "
"single_label)。multi_label はデータセットの隣にある label_schema.json と labels.jsonl "
"を読み、ラベルごとに独立したシグモイドを学習します。PyTorch のみ。"

#: mb/cli/parsing/train.py:119
msgid ""
"Train at --image-size even when the architecture expects a different one. "
"Only affects backbones with a fixed input resolution (e.g. siglip2_*), where"
" a mismatch means the pretrained position embeddings no longer line up."
msgstr ""
"アーキテクチャが別のサイズを想定していても --image-size で学習します。入力解像度が固定のバックボーン (例: siglip2_*) "
"にだけ影響します。サイズが一致しないと、事前学習済みの位置埋め込みが揃わなくなります。"

#: mb/cli/parsing/train.py:128
msgid ""
"Compensate an imbalanced training set by weighting the training loss "
"(image_classification only; default: from config). Validation loss stays "
"unweighted so it remains comparable across settings."
msgstr ""
"不均衡な学習データセットを、学習損失に重みを付けて補正します (image_classification のみ。既定: "
"設定から)。検証損失は重みなしのままなので、条件が違っても比較できます。"

#: mb/cli/parsing/train.py:137
msgid ""
"Ceiling on any single class weight (--class-weighting inverse_frequency "
"only; default: from config)"
msgstr "単一クラスの重みの上限 (--class-weighting inverse_frequency のみ。既定: 設定から)"

#: mb/cli/parsing/train.py:145
msgid ""
"Random seed. Consumed by --model-type image_generation_lora (reproducible "
"LoRA weight init and noise sampling) and text_classification (overrides "
"text_classification.seed)."
msgstr ""
"ランダムシード。--model-type image_generation_lora（再現可能なLoRAウェイト初期化とノイズサンプリング）および "
"text_classification（text_classification.seed を上書き）で使用されます。"

#: mb/cli/parsing/train.py:153
msgid ""
"LoRA adapter rank (--model-type image_generation_lora only; default: 16)"
msgstr "LoRA アダプタのランク (--model-type image_generation_lora のみ。既定: 16)"

#: mb/cli/parsing/train.py:159
msgid ""
"LoRA adapter alpha scaling (--model-type image_generation_lora only; "
"default: same as --lora-rank)"
msgstr ""
"LoRA アダプタのアルファスケーリング (--model-type image_generation_lora のみ。既定: --lora-rank "
"と同じ)"

#: mb/cli/parsing/train.py:167
msgid ""
"Learning rate for the LoRA adapter parameters (--model-type "
"image_generation_lora; default: 1e-4), or text_classification.optim.lr "
"(--model-type text_classification). Unrelated to --frozen-lr/--unfrozen-lr-*"
" (image_classification only)."
msgstr ""
"LoRAアダプターパラメータの学習率（--model-type image_generation_lora；デフォルト：1e-4）または "
"text_classification.optim.lr（--model-type text_classification）。--frozen-"
"lr/--unfrozen-lr-*（画像分類のみ）とは無関係です。"

#: mb/cli/parsing/train.py:177
msgid ""
"Total optimizer steps to train (--model-type image_generation_lora only; "
"default: 1000). LoRA training here is step-based, not epoch-based."
msgstr ""
"学習するオプティマイザの合計ステップ数 (--model-type image_generation_lora のみ。既定: 1000)。ここでの "
"LoRA 学習はエポック単位ではなくステップ単位です。"

#: mb/cli/parsing/train.py:186
msgid ""
"--model-type image_generation_lora only: the base model's architecture "
"(different architectures load different components and LoRA target layers). "
"Auto-detected from a local checkpoint's model_index.json when omitted; "
"required when --architecture is a hub id rather than a local path, since "
"that can't be auto-detected without a network call. flux (recommended "
"default), chroma, and stable_diffusion_1x are implemented today — "
"stable_diffusion_xl, stable_diffusion_3, and z_image_turbo are recognized "
"but not yet supported."
msgstr ""
"--model-type image_generation_lora のみ: ベースモデルのアーキテクチャ "
"(アーキテクチャが異なると、読み込むコンポーネントと LoRA 対象レイヤーが異なります)。省略時はローカルチェックポイントの "
"model_index.json から自動検出します。--architecture がローカルパスではなく hub id "
"のときは必須です。ネットワーク呼び出しなしでは自動検出できないためです。flux (推奨の既定)、chroma、stable_diffusion_1x "
"は現在実装済みです - stable_diffusion_xl、stable_diffusion_3、z_image_turbo "
"は認識されますが、まだ対応していません。"

#: mb/cli/parsing/train.py:200
msgid ""
"--model-type text_classification only: model family (default: "
"text_classification.backend)"
msgstr ""
"--model-type text_classification のみ: モデルファミリ (デフォルト: "
"text_classification.backend)"

#: mb/cli/parsing/train.py:209
msgid ""
"--model-type text_classification only: Hugging Face id or local path of the "
"model within the family (default: text_classification.model_id, else the "
"backend's default)"
msgstr ""
"--model-type text_classification only: Hugging Face ID "
"またはファミリー内のモデルのローカルパス（デフォルト: "
"text_classification.model_id、そうでない場合はバックエンドのデフォルト）"

#: mb/cli/parsing/train.py:219
msgid ""
"--model-type text_classification only: maximum training epochs (default: "
"text_classification.optim.epochs, else the backend's default)"
msgstr ""
"--model-type text_classification only: 最大トレーニングエポック数（デフォルト: "
"text_classification.optim.epochs、またはバックエンドのデフォルト）"

#: mb/cli/parsing/train.py:226
msgid "Path to checkpoint to resume training from"
msgstr "学習を再開するチェックポイントのパス"

#: mb/cli/parsing/train.py:236
msgid "Skip updating the unified snapshot with training data"
msgstr "学習データによる統合スナップショットの更新を省略"

#: mb/cli/parsing/train.py:243
msgid ""
"Load TrainingRunArgs from JSON (see mb.training.run_args); other train flags"
" are ignored"
msgstr ""
"JSON から TrainingRunArgs を読み込みます (mb.training.run_args を参照)。他の train "
"フラグは無視されます"

#: mb/conversion/quantize.py:42
msgid ""
"fp16 quantization needs onnx and onnxconverter-common. Install with: pip "
"install onnxconverter-common"
msgstr ""
"fp16 量子化には onnx と onnxconverter-common が必要です。インストール: pip install "
"onnxconverter-common"

#: mb/conversion/quantize.py:63
msgid ""
"int8/uint8 quantization needs onnxruntime. Install with: pip install -e "
"\".[onnx]\""
msgstr "int8/uint8 量子化には onnxruntime が必要です。インストール: pip install -e \".[onnx]\""

#: mb/conversion/quantize.py:97
msgid "Unknown quantization mode: {mode}"
msgstr "不明な量子化モード: {mode}"

#: mb/conversion/quantize.py:102
msgid "ONNX file not found: {path}"
msgstr "ONNX ファイルが見つかりません: {path}"

#: mb/conversion/quantize.py:115
msgid "Quantization to {mode} failed: {err}"
msgstr "{mode} への量子化に失敗しました: {err}"

#: mb/data/dataset.py:1130
msgid "Source and target directories are on the same drive."
msgstr "ソースディレクトリとターゲットディレクトリは同じドライブにあります。"

#: mb/data/dataset.py:1132
msgid ""
"The script will use copy operations (not move) to preserve source files."
msgstr "スクリプトはソースファイルを残すため、移動ではなくコピーを使います。"

#: mb/data/dataset.py:1151
msgid ""
"Source drive {drive} is the system drive. Proceeding without confirmation."
msgstr "ソースドライブ {drive} はシステムドライブです。確認なしで続行します。"

#: mb/data/dataset.py:1161
msgid "NOTE: Source drive {src} is different from system drive {sys}."
msgstr "注意: ソースドライブ {src} はシステムドライブ {sys} と異なります。"

#: mb/data/dataset.py:1167
msgid ""
"This may indicate an external drive that failed detection. Consider whether "
"to proceed."
msgstr "検出に失敗した外部ドライブを示している可能性があります。続行するかどうかを検討してください。"

#: mb/data/dataset.py:1173
msgid ""
"NOTE: Unable to determine system drive. If this is not your main system "
"drive,"
msgstr "注意: システムドライブを判定できません。これがお使いのメインのシステムドライブでない場合、"

#: mb/data/dataset.py:1178
msgid ""
"it may indicate an external drive that failed detection. Consider whether to"
" proceed."
msgstr "検出に失敗した外部ドライブである可能性があります。続行するかどうかを検討してください。"

#: mb/data/dataset.py:1183
msgid ""
"NOTE: If this is not your main system drive, it may indicate an external "
"drive"
msgstr "注意: これがお使いのメインのシステムドライブでない場合、外部ドライブ"

#: mb/data/dataset.py:1185
msgid "that failed detection. Consider whether to proceed."
msgstr "の検出に失敗した可能性があります。続行するかどうかを検討してください。"

#: mb/data/dataset.py:1187
msgid "Continue with same-drive operation? (y/N): "
msgstr "同じドライブで操作を続行しますか? (y/N): "

#: mb/data/dataset.py:1189
msgid "Operation cancelled by user."
msgstr "操作はユーザーによってキャンセルされました。"

#: mb/data/label_schema.py:91
msgid "Label {label} is not in the schema."
msgstr "ラベル {label} はスキーマにありません。"

#: mb/data/label_schema.py:123
msgid "Schema 'axes' must be an object."
msgstr "スキーマの 'axes' はオブジェクトでなければなりません。"

#: mb/data/label_schema.py:130
msgid "Axis {name} must be an object with a 'labels' list."
msgstr "軸 {name} は 'labels' リストを持つオブジェクトでなければなりません。"

#: mb/data/label_schema.py:135
msgid "Axis {name} must list at least one label."
msgstr "軸 {name} にはラベルが少なくとも 1 つ必要です。"

#: mb/data/label_schema.py:140
msgid "Axis {name} references labels not in the schema: {unknown}"
msgstr "軸 {name} はスキーマにないラベルを参照しています: {unknown}"

#: mb/data/label_schema.py:161
msgid "Schema must contain a non-empty 'labels' list."
msgstr "スキーマには空でない 'labels' リストが含まれている必要があります。"

#: mb/data/label_schema.py:165
msgid "Schema labels must not be empty strings."
msgstr "スキーマのラベルを空の文字列にしてはなりません。"

#: mb/data/label_schema.py:170
msgid "Schema has duplicate labels: {names}"
msgstr "スキーマに重複したラベルがあります: {names}"

#: mb/data/label_schema.py:175
msgid "Schema 'default_thresholds' must be an object."
msgstr "スキーマの 'default_thresholds' はオブジェクトでなければなりません。"

