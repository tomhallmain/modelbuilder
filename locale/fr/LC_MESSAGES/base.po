#: mb/cli/parsing/data.py:18
msgid "Data processing operations"
msgstr "Opérations de traitement des données"

#: mb/cli/parsing/data.py:19
msgid "Data processing operations for preparing image datasets"
msgstr ""
"Opérations de traitement des données pour préparer des jeux de données "
"d'images"

#: mb/cli/parsing/data.py:23
msgid "Data subcommands"
msgstr "Sous-commandes de données"

#: mb/cli/parsing/data.py:30
msgid "Gather images from source directories"
msgstr "Rassembler les images depuis les répertoires sources"

#: mb/cli/parsing/data.py:32
msgid ""
"Gather images from source directories into a target directory, with "
"deduplication and optional weighting by subdirectory."
msgstr ""
"Rassemble les images des répertoires sources dans un répertoire cible, avec "
"déduplication et pondération facultative par sous-répertoire."

#: mb/cli/parsing/data.py:40
msgid "Source directory containing images"
msgstr "Répertoire source contenant les images"

#: mb/cli/parsing/data.py:46
msgid "Subdirectories to process"
msgstr "Sous-répertoires à traiter"

#: mb/cli/parsing/data.py:53
msgid ""
"Target number of images to gather (default: from pipeline "
"data.gather.default_target_count). Treated as a limit, not an exact "
"requirement."
msgstr ""
"Nombre cible d'images à rassembler (par défaut : depuis le pipeline, "
"data.gather.default_target_count). Considéré comme une limite, pas comme une"
" exigence exacte."

#: mb/cli/parsing/data.py:61
msgid ""
"Target directory for gathered images (default: from pipeline "
"data.gather.default_target_dir)"
msgstr ""
"Répertoire cible des images rassemblées (par défaut : depuis le pipeline, "
"data.gather.default_target_dir)"

#: mb/cli/parsing/data.py:67
msgid ""
"Rejected directory for manually rejected images (default: "
"data.gather.default_rejected_dir)"
msgstr ""
"Répertoire de rejet pour les images rejetées manuellement (par défaut : "
"data.gather.default_rejected_dir)"

#: mb/cli/parsing/data.py:73
msgid ""
"Relative weights for subdirectories: \"subdir1:weight1,subdir2:weight2\" "
"(e.g. \"neutral:4,drawing:1\" ≈ 80%%/20%%, or \"neutral:0.8,drawing:0.2\"). "
"Weights are normalized automatically; any positive numbers work."
msgstr ""
"Poids relatifs des sous-répertoires : \"subdir1:weight1,subdir2:weight2\" "
"(p. ex. \"neutral:4,drawing:1\" ~ 80%%/20%%, ou "
"\"neutral:0.8,drawing:0.2\"). Les poids sont normalisés automatiquement ; "
"tout nombre positif convient."

#: mb/cli/parsing/data.py:82
msgid ""
"Root directory for raw data (default: data.raw_data_dir in pipeline config)"
msgstr ""
"Répertoire racine des données brutes (par défaut : data.raw_data_dir dans la"
" configuration du pipeline)"

#: mb/cli/parsing/data.py:89
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, gather also considers configured video extensions."
msgstr ""
"Type de modèle du pipeline (par défaut : model.default_type). Pour "
"image_classification, la collecte tient aussi compte des extensions vidéo "
"configurées."

#: mb/cli/parsing/data.py:97
msgid "Convert images to specified format"
msgstr "Convertir les images au format indiqué"

#: mb/cli/parsing/data.py:99
msgid ""
"Convert images in the raw data directory to a specified format (e.g., JPEG)."
" Large images are automatically resized to prevent memory issues."
msgstr ""
"Convertit les images du répertoire de données brutes vers un format indiqué "
"(p. ex. JPEG). Les grandes images sont redimensionnées automatiquement afin "
"d'éviter les problèmes de mémoire."

#: mb/cli/parsing/data.py:107 mb/cli/parsing/data.py:194
#: mb/cli/parsing/data.py:220 mb/cli/parsing/data.py:413
msgid "Raw data directory (default: raw_data)"
msgstr "Répertoire de données brutes (par défaut : raw_data)"

#: mb/cli/parsing/data.py:114
msgid ""
"Target format for converted outputs (default: jpeg). The converter is "
"currently JPEG-oriented; non-default values may be ignored until "
"implemented."
msgstr ""
"Format cible des sorties converties (par défaut : jpeg). Le convertisseur "
"est actuellement orienté JPEG ; les valeurs autres que celle par défaut "
"peuvent être ignorées jusqu'à ce qu'elles soient implémentées."

#: mb/cli/parsing/data.py:123
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, videos and multi-frame GIFs get a random frame as "
"JPEG."
msgstr ""
"Type de modèle du pipeline (par défaut : model.default_type). Lorsque la "
"valeur est image_classification, les vidéos et les GIF multi-images "
"reçoivent une image aléatoire au format JPEG."

#: mb/cli/parsing/data.py:131
msgid ""
"Allow convert to run even if the raw-data drive appears to have insufficient"
" free space (heuristic estimate; not recommended)."
msgstr ""
"Autoriser l'exécution de convert même si le lecteur des données brutes "
"semble manquer d'espace libre (estimation heuristique ; non recommandé)."

#: mb/cli/parsing/data.py:140
msgid ""
"Unified snapshot run ID to update (snapshot_<run_id>.json under raw data). "
"Omit to start a new snapshot with a new run ID."
msgstr ""
"ID d'exécution de l'instantané unifié à mettre à jour "
"(snapshot_<run_id>.json sous les données brutes). Omettre pour démarrer un "
"nouvel instantané avec un nouvel ID d'exécution."

#: mb/cli/parsing/data.py:148
msgid "Remove duplicate images"
msgstr "Supprimer les images en double"

#: mb/cli/parsing/data.py:150
msgid ""
"Remove duplicate images within and across class directories. Uses perceptual"
" hashing to identify duplicates and moves them to a review directory."
msgstr ""
"Supprime les images en double à l'intérieur des répertoires de classe et "
"entre eux. Utilise un hachage perceptuel pour identifier les doublons et les"
" déplace vers un répertoire d'examen."

#: mb/cli/parsing/data.py:159
msgid ""
"Root raw data directory containing class subdirectories (default: raw_data)."
" Typical layouts include multiple class folders under this root."
msgstr ""
"Répertoire racine des données brutes contenant des sous-répertoires de "
"classe (par défaut : raw_data). Les dispositions habituelles comprennent "
"plusieurs dossiers de classe sous cette racine."

#: mb/cli/parsing/data.py:167
msgid ""
"Scan and print duplicate groups as indented JSON (no removals). Useful for "
"manual review workflows."
msgstr ""
"Analyse et affiche les groupes de doublons en JSON indenté (aucune "
"suppression). Utile pour les flux d'examen manuel."

#: mb/cli/parsing/data.py:176
msgid ""
"Optional unified snapshot run ID to update with deduplication metadata. If "
"omitted, the latest loadable snapshot under raw data is used when available."
msgstr ""
"ID d'exécution facultatif de l'instantané unifié à mettre à jour avec les "
"métadonnées de déduplication. S'il est omis, le dernier instantané "
"chargeable sous les données brutes est utilisé lorsqu'il est disponible."

#: mb/cli/parsing/data.py:184
msgid "Upscale small images"
msgstr "Agrandir les petites images"

#: mb/cli/parsing/data.py:186
msgid ""
"Upscale images that are smaller than a minimum dimension threshold. Small "
"images are moved to a review directory for manual inspection before "
"upscaling."
msgstr ""
"Agrandit les images plus petites qu'un seuil de dimension minimale. Les "
"petites images sont déplacées vers un répertoire d'examen pour une "
"inspection manuelle avant l'agrandissement."

#: mb/cli/parsing/data.py:200
msgid ""
"Review directory containing small images to upscale (default: <raw-data-"
"dir>/small_images_review). Upscaled outputs go under <review-"
"dir>/upscaled_small_images."
msgstr ""
"Répertoire d'examen contenant les petites images à agrandir (par défaut : "
"<raw-data-dir>/small_images_review). Les sorties agrandies sont placées sous"
" <review-dir>/upscaled_small_images."

#: mb/cli/parsing/data.py:209
msgid "Create train/test dataset splits"
msgstr "Créer les répartitions entraînement/test du jeu de données"

#: mb/cli/parsing/data.py:211
msgid ""
"Create training and test dataset splits from raw data. Validates images, "
"removes corrupted files, filters by size, and creates balanced train/test "
"splits with hash-based filenames."
msgstr ""
"Crée des répartitions d'entraînement et de test à partir des données brutes."
" Valide les images, supprime les fichiers corrompus, filtre par taille et "
"crée des répartitions entraînement/test équilibrées avec des noms de fichier"
" basés sur un hachage."

#: mb/cli/parsing/data.py:226
msgid "Output data directory (default: data)"
msgstr "Répertoire de données de sortie (par défaut : data)"

#: mb/cli/parsing/data.py:233
msgid ""
"Number of items per class in the test split when mode is fixed; also the "
"anchor for dataset-weighted mode (default: data.test_per_class from pipeline"
" YAML)."
msgstr ""
"Nombre d'éléments par classe dans la répartition de test lorsque le mode est"
" fixed ; aussi l'ancre du mode dataset-weighted (par défaut : "
"data.test_per_class du YAML du pipeline)."

#: mb/cli/parsing/data.py:242
msgid ""
"fixed = test_per_class images per class; dataset-weighted = modulated counts"
" from class size vs total (default: data.test_split_mode in pipeline YAML, "
"else fixed)."
msgstr ""
"fixed = test_per_class images par classe ; dataset-weighted = effectifs "
"modulés d'après la taille de la classe par rapport au total (par défaut : "
"data.test_split_mode dans le YAML du pipeline, sinon fixed)."

#: mb/cli/parsing/data.py:251
msgid ""
"With dataset-weighted mode: classes with fewer images than this use a "
"proportional test count; larger classes use anchor + anchor×(class_share). "
"Omit to use --test-per-class as the threshold (default: pipeline "
"data.test_small_class_threshold)."
msgstr ""
"Avec le mode dataset-weighted : les classes ayant moins d'images que cette "
"valeur utilisent un effectif de test proportionnel ; les classes plus "
"grandes utilisent ancre + ancre x (class_share). Omettre pour utiliser "
"--test-per-class comme seuil (par défaut : data.test_small_class_threshold "
"du pipeline)."

#: mb/cli/parsing/data.py:261
msgid ""
"Random seed for reproducibility (default: data.seed from pipeline YAML when "
"set, else non-deterministic)"
msgstr ""
"Graine aléatoire pour la reproductibilité (par défaut : data.seed du YAML du"
" pipeline lorsqu'elle est définie, sinon non déterministe)"

#: mb/cli/parsing/data.py:267 mb/cli/parsing/train.py:231
msgid ""
"Run ID of unified snapshot to update (auto-detects latest if not provided)"
msgstr ""
"ID d'exécution de l'instantané unifié à mettre à jour (détecte "
"automatiquement le plus récent s'il n'est pas fourni)"

#: mb/cli/parsing/data.py:273
msgid ""
"Balance the training set to the smallest class size (default: off, keeps "
"natural proportions)."
msgstr ""
"Équilibrer le jeu d'entraînement sur la taille de la plus petite classe (par"
" défaut : off, conserve les proportions naturelles)."

#: mb/cli/parsing/data.py:280
msgid ""
"Maximum training items per class (no limit if omitted; keeps natural "
"proportions below the cap)."
msgstr ""
"Nombre maximal d'éléments d'entraînement par classe (aucune limite si omis ;"
" les proportions naturelles sont conservées sous le plafond)."

#: mb/cli/parsing/data.py:286
msgid "Allow running on external/removable storage (not recommended)"
msgstr ""
"Autoriser l'exécution sur un stockage externe ou amovible (non recommandé)"

#: mb/cli/parsing/data.py:292
msgid ""
"Allow create-dataset even if the output data drive appears to have "
"insufficient free space (heuristic estimate; not recommended)."
msgstr ""
"Autoriser create-dataset même si le lecteur des données de sortie semble "
"manquer d'espace libre (estimation heuristique ; non recommandé)."

#: mb/cli/parsing/data.py:301
msgid ""
"Pipeline model type (default: model.default_type). image_classification "
"builds train/test ImageFolder splits from class subdirectories (all other "
"options above apply); image_generation_lora instead copies every image "
"directly under --raw-data-dir (no class folders, no train/test split) plus "
"its optional .txt caption sidecar into --data-dir, for LoRA fine-tuning of "
"an image-generation model."
msgstr ""
"Type de modèle du pipeline (par défaut : model.default_type). "
"image_classification construit des répartitions entraînement/test "
"ImageFolder à partir des sous-répertoires de classe (toutes les autres "
"options ci-dessus s'appliquent) ; image_generation_lora copie plutôt dans "
"--data-dir chaque image située directement sous --raw-data-dir (pas de "
"dossiers de classe, pas de répartition entraînement/test) ainsi que son "
"fichier .txt de légende facultatif associé, pour le réglage fin LoRA d'un "
"modèle de génération d'images."

#: mb/cli/parsing/data.py:312
msgid "Rename mislabeled .jpg sources and rebuild CONVERTED JPEGs"
msgstr ""
"Renommer les sources .jpg mal étiquetées et reconstruire les JPEG de "
"CONVERTED"

#: mb/cli/parsing/data.py:314
msgid ""
"Finds non-JPEG bytes under .jpg/.jpeg names in class source trees (same "
"discovery as convert), writes corrected JPEGs, and removes stale copies "
"under CONVERTED and small_images_review only after a successful write. "
"Animated GIFs use the same random-frame + visual_media_review layout as "
"convert when the model type is image_classification."
msgstr ""
"Trouve des octets qui ne sont pas du JPEG sous des noms .jpg/.jpeg dans les "
"arborescences sources de classe (même découverte que convert), écrit des "
"JPEG corrigés et supprime les copies obsolètes sous CONVERTED et "
"small_images_review seulement après une écriture réussie. Les GIF animés "
"utilisent la même disposition image aléatoire + visual_media_review que "
"convert lorsque le type de modèle est image_classification."

#: mb/cli/parsing/data.py:325
msgid ""
"Raw data directory (default: data.raw_data_dir from the pipeline config "
"after --config; same as gather/convert when omitted)."
msgstr ""
"Répertoire de données brutes (par défaut : data.raw_data_dir de la "
"configuration du pipeline après --config ; identique à gather/convert si "
"omis)."

#: mb/cli/parsing/data.py:332
msgid "Log planned repairs only; do not rename files or write outputs."
msgstr ""
"Journaliser uniquement les réparations prévues ; ne pas renommer les "
"fichiers ni écrire les sorties."

#: mb/cli/parsing/data.py:339
msgid ""
"Print newline-delimited JSON (stdout): dry-run or live repair. By default "
"only actionable mismatches are listed; use -v to include policy-skipped "
"PNG/WebP/BMP/TIFF under .jpg. Live repair emits one line per successful fix "
"when applicable."
msgstr ""
"Affiche du JSON délimité par des sauts de ligne (stdout) : simulation ou "
"réparation réelle. Par défaut, seules les incohérences corrigeables sont "
"listées ; utilisez -v pour inclure les PNG/WebP/BMP/TIFF sous .jpg ignorés "
"par la politique. La réparation réelle émet une ligne par correction réussie"
" le cas échéant."

#: mb/cli/parsing/data.py:348
msgid ""
"With --dry-run and --json: include Pillow format and GIF metadata in each "
"JSON object."
msgstr ""
"Avec --dry-run et --json : inclure le format Pillow et les métadonnées GIF "
"dans chaque objet JSON."

#: mb/cli/parsing/data.py:355
msgid ""
"With --dry-run: omit verbose per-file log lines (use with --json for "
"machine-readable output only)."
msgstr ""
"Avec --dry-run : omettre les lignes de journal détaillées par fichier (à "
"utiliser avec --json pour une sortie uniquement lisible par une machine)."

#: mb/cli/parsing/data.py:364
msgid ""
"With --json: include policy-skipped static-format mismatches in JSON output."
" In text mode: log each policy-skipped file and class progress for every "
"folder; with live repair, log each skipped file. Useless with --quiet. "
"Separate from top-level mb -v (global logging)."
msgstr ""
"Avec --json : inclure dans la sortie JSON les incohérences de format "
"statique ignorées par la politique. En mode texte : journaliser chaque "
"fichier ignoré par la politique et la progression de classe pour chaque "
"dossier ; avec la réparation réelle, journaliser chaque fichier ignoré. Sans"
" effet avec --quiet. Distinct de mb -v au niveau supérieur (journalisation "
"globale)."

#: mb/cli/parsing/data.py:374
msgid ""
"Also rename/repair mislabeled .jpg/.jpeg whose bytes are PNG, WebP, BMP, or "
"TIFF. By default those are counted and summarized per class only (GIF and "
"animated-IC cases are always repaired)."
msgstr ""
"Renomme ou répare aussi les .jpg/.jpeg mal étiquetés dont les octets sont "
"PNG, WebP, BMP ou TIFF. Par défaut, ils sont seulement comptés et résumés "
"par classe (les cas GIF et animated-IC sont toujours réparés)."

#: mb/cli/parsing/data.py:382
msgid "Pipeline model type (default: model.default_type)."
msgstr "Type de modèle du pipeline (par défaut : model.default_type)."

#: mb/cli/parsing/data.py:388
msgid "RNG seed for random GIF frame selection (optional)."
msgstr "Graine pour la sélection aléatoire d'une image GIF (facultatif)."

#: mb/cli/parsing/data.py:394
msgid "Estimate disk space needed for convert or create-dataset"
msgstr "Estimer l'espace disque nécessaire pour convert ou create-dataset"

#: mb/cli/parsing/data.py:396
msgid ""
"Walks source files (same rules as convert/dataset) and compares a rough byte"
" estimate to free space on the target volume. Exits non-zero if the estimate"
" exceeds free space."
msgstr ""
"Parcourt les fichiers sources (mêmes règles que convert/dataset) et compare "
"une estimation approximative en octets à l'espace libre du volume cible. Se "
"termine avec un code non nul si l'estimation dépasse l'espace libre."

#: mb/cli/parsing/data.py:407
msgid "Which step to estimate for"
msgstr "Étape à estimer"

#: mb/cli/parsing/data.py:418
msgid "Output data directory (required when operation is create-dataset)"
msgstr ""
"Répertoire de données de sortie (obligatoire lorsque l'opération est create-"
"dataset)"

#: mb/cli/parsing/evaluate.py:16
msgid "Evaluate trained models or datasets"
msgstr "Évaluer des modèles entraînés ou des jeux de données"

#: mb/cli/parsing/evaluate.py:18
msgid ""
"Score a trained classifier on your train/test tree, surface likely labeling "
"mistakes, or compare two checkpoints on the same data."
msgstr ""
"Note un classifieur entraîné sur votre arborescence entraînement/test, "
"signale les erreurs d'étiquetage probables ou compare deux points de "
"contrôle sur les mêmes données."

#: mb/cli/parsing/evaluate.py:24
msgid "Evaluate subcommands"
msgstr "Sous-commandes d'évaluation"

#: mb/cli/parsing/evaluate.py:30
msgid "Compute classification metrics on a labeled split"
msgstr ""
"Calculer les métriques de classification sur une répartition étiquetée"

#: mb/cli/parsing/evaluate.py:32
msgid ""
"Accuracy, confusion matrix, and per-class counts on an ImageFolder-style "
"directory (class-named subfolders of images). PyTorch requires "
"--architecture and a .pth/.pt file."
msgstr ""
"Exactitude, matrice de confusion et effectifs par classe sur un répertoire "
"de style ImageFolder (sous-dossiers d'images nommés d'après la classe). "
"PyTorch exige --architecture et un fichier .pth/.pt."

#: mb/cli/parsing/evaluate.py:40 mb/cli/parsing/evaluate.py:133
msgid "Path to trained model file (.pth / .pt / .h5 / .keras)"
msgstr "Chemin du fichier de modèle entraîné (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:46 mb/cli/parsing/evaluate.py:139
#: mb/cli/parsing/evaluate.py:234
msgid "ImageFolder root (e.g. .../test with one subfolder per class)"
msgstr "Racine ImageFolder (p. ex. .../test avec un sous-dossier par classe)"

#: mb/cli/parsing/evaluate.py:52 mb/cli/parsing/evaluate.py:145
msgid "Training framework (default: infer from file extension)"
msgstr ""
"Framework d'entraînement (par défaut : déduire de l'extension du fichier)"

#: mb/cli/parsing/evaluate.py:58 mb/cli/parsing/evaluate.py:151
msgid ""
"Model architecture id (required for PyTorch .pth checkpoints, e.g. resnet34)"
msgstr ""
"Identifiant d'architecture du modèle (obligatoire pour les points de "
"contrôle .pth PyTorch, p. ex. resnet34)"

#: mb/cli/parsing/evaluate.py:64 mb/cli/parsing/evaluate.py:157
#: mb/cli/parsing/evaluate.py:264
msgid "Override class count (default: infer from directory layout)"
msgstr ""
"Forcer le nombre de classes (par défaut : déduire de la disposition du "
"répertoire)"

#: mb/cli/parsing/evaluate.py:70 mb/cli/parsing/evaluate.py:163
#: mb/cli/parsing/evaluate.py:270
msgid "Pipeline model type (default: image_classification)"
msgstr "Type de modèle du pipeline (par défaut : image_classification)"

#: mb/cli/parsing/evaluate.py:76 mb/cli/parsing/evaluate.py:169
#: mb/cli/parsing/evaluate.py:276
msgid "Square input size (default: 224)"
msgstr "Taille d'entrée carrée (par défaut : 224)"

#: mb/cli/parsing/evaluate.py:82 mb/cli/parsing/evaluate.py:175
#: mb/cli/parsing/evaluate.py:282
msgid "Batch size (default: 32)"
msgstr "Taille de lot (par défaut : 32)"

#: mb/cli/parsing/evaluate.py:88 mb/cli/parsing/evaluate.py:181
#: mb/cli/parsing/evaluate.py:288
msgid "DataLoader workers for PyTorch (default: 0)"
msgstr "Processus DataLoader pour PyTorch (par défaut : 0)"

#: mb/cli/parsing/evaluate.py:94 mb/cli/parsing/evaluate.py:187
#: mb/cli/parsing/evaluate.py:294
msgid "PyTorch device override, e.g. cuda or cpu (default: auto)"
msgstr ""
"Forçage du périphérique PyTorch, p. ex. cuda ou cpu (par défaut : auto)"

#: mb/cli/parsing/evaluate.py:101
msgid ""
"How the model's output is interpreted (default: single_label). multi_label "
"reads label_schema.json beside the dataset and reports per-label metrics "
"instead of accuracy and a confusion matrix."
msgstr ""
"Façon d'interpréter la sortie du modèle (par défaut : single_label). "
"multi_label lit label_schema.json à côté du jeu de données et indique des "
"métriques par étiquette au lieu de l'exactitude et d'une matrice de "
"confusion."

#: mb/cli/parsing/evaluate.py:110
msgid ""
"--label-mode multi_label only: pick the per-label threshold that maximizes "
"each label's F1 on this split and write it back to label_schema.json. A "
"post-hoc calibration step — never run this on the training split."
msgstr ""
"Uniquement avec --label-mode multi_label : choisir le seuil par étiquette "
"qui maximise le F1 de chaque étiquette sur cette répartition et le réécrire "
"dans label_schema.json. Étape de calibration a posteriori : ne jamais "
"l'exécuter sur la répartition d'entraînement."

#: mb/cli/parsing/evaluate.py:118 mb/cli/parsing/evaluate.py:205
#: mb/cli/parsing/evaluate.py:315
msgid "Validate arguments and exit without running inference"
msgstr "Valider les arguments et quitter sans exécuter l'inférence"

#: mb/cli/parsing/evaluate.py:123
msgid "List images whose predicted class differs from the folder label"
msgstr ""
"Lister les images dont la classe prédite diffère de l'étiquette du dossier"

#: mb/cli/parsing/evaluate.py:125
msgid ""
"Compares model predictions to ImageFolder-style on-disk class folders to "
"surface label noise and borderline samples. Image classification only."
msgstr ""
"Compare les prédictions du modèle aux dossiers de classe sur disque de style"
" ImageFolder pour signaler le bruit d'étiquetage et les échantillons "
"limites. Classification d'images uniquement."

#: mb/cli/parsing/evaluate.py:194
msgid ""
"Cap printed / exported misclassified rows (default: no cap; totals still "
"full)"
msgstr ""
"Plafonner les lignes mal classées affichées ou exportées (par défaut : aucun"
" plafond ; les totaux restent complets)"

#: mb/cli/parsing/evaluate.py:200
msgid "Optional CSV path (still prints a summary to stdout)"
msgstr "Chemin CSV facultatif (un résumé est toujours affiché sur stdout)"

#: mb/cli/parsing/evaluate.py:210
msgid ""
"Compare two models on the same labeled split (paired outcomes & "
"disagreements)"
msgstr ""
"Comparer deux modèles sur la même répartition étiquetée (résultats appariés "
"et désaccords)"

#: mb/cli/parsing/evaluate.py:212
msgid ""
"Runs both checkpoints on the same ImageFolder split in lockstep: top-1 "
"accuracy each, a 2×2-style breakdown (both correct, only A, only B, both "
"wrong vs folder labels), and how often A and B disagree on the predicted "
"class. PyTorch and Keras supported when both files use the same framework."
msgstr ""
"Exécute les deux points de contrôle en parallèle sur la même répartition "
"ImageFolder : exactitude top-1 de chacun, une ventilation de type 2x2 (tous "
"deux corrects, seulement A, seulement B, tous deux incorrects par rapport "
"aux étiquettes du dossier) et la fréquence à laquelle A et B divergent sur "
"la classe prédite. PyTorch et Keras sont pris en charge lorsque les deux "
"fichiers utilisent le même framework."

#: mb/cli/parsing/evaluate.py:222
msgid "Path to first model file (.pth / .pt / .h5 / .keras)"
msgstr "Chemin du premier fichier de modèle (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:228
msgid "Path to second model file (.pth / .pt / .h5 / .keras)"
msgstr "Chemin du second fichier de modèle (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:240
msgid ""
"Training framework hint for both models (default: infer from each file)"
msgstr ""
"Indication du framework d'entraînement pour les deux modèles (par défaut : "
"déduire de chaque fichier)"

#: mb/cli/parsing/evaluate.py:246
msgid ""
"Optional framework hint for model B only (default: same as --framework)"
msgstr ""
"Indication de framework facultative pour le modèle B seul (par défaut : "
"identique à --framework)"

#: mb/cli/parsing/evaluate.py:252
msgid "Model architecture id for PyTorch model A (e.g. resnet34)"
msgstr "Identifiant d'architecture du modèle A PyTorch (p. ex. resnet34)"

#: mb/cli/parsing/evaluate.py:258
msgid ""
"Architecture for PyTorch model B when it differs from model A (default: "
"--architecture)"
msgstr ""
"Architecture du modèle B PyTorch lorsqu'elle diffère du modèle A (par défaut"
" : --architecture)"

#: mb/cli/parsing/evaluate.py:302
msgid ""
"Cap printed / exported rows where A and B disagree on class (default: no "
"cap; totals still full)"
msgstr ""
"Plafonner les lignes affichées ou exportées où A et B divergent sur la "
"classe (par défaut : aucun plafond ; les totaux restent complets)"

#: mb/cli/parsing/evaluate.py:310
msgid ""
"Optional TSV path for disagreement rows (summary still prints to stdout)"
msgstr ""
"Chemin TSV facultatif pour les lignes de désaccord (le résumé est toujours "
"affiché sur stdout)"

#: mb/cli/parsing/export.py:15
msgid "Export model bundle artifacts"
msgstr "Exporter les artefacts du paquet de modèle"

#: mb/cli/parsing/export.py:17
msgid ""
"Export deployment bundle artifacts such as safetensors weights and metadata "
"manifests."
msgstr ""
"Exporte des artefacts du paquet de déploiement, tels que des poids "
"safetensors et des manifestes de métadonnées."

#: mb/cli/parsing/export.py:22
msgid "Export subcommands"
msgstr "Sous-commandes d'export"

#: mb/cli/parsing/export.py:28
msgid ""
"Export a model bundle (safetensors + manifest + optional architecture stub)"
msgstr ""
"Exporter un paquet de modèle (safetensors + manifeste + ébauche "
"d'architecture facultative)"

#: mb/cli/parsing/export.py:30
msgid "Input model file (.pth/.pt)"
msgstr "Fichier de modèle en entrée (.pth/.pt)"

#: mb/cli/parsing/export.py:31
msgid "Output bundle directory"
msgstr "Répertoire du paquet de sortie"

#: mb/cli/parsing/export.py:32
msgid "Model architecture id (e.g. resnet34)"
msgstr "Identifiant d'architecture du modèle (p. ex. resnet34)"

#: mb/cli/parsing/export.py:33
msgid "Number of output classes"
msgstr "Nombre de classes de sortie"

#: mb/cli/parsing/export.py:34
msgid "Optional ordered class names"
msgstr "Noms de classe ordonnés facultatifs"

#: mb/cli/parsing/export.py:35
msgid "Optional data dir to infer class names from train/"
msgstr ""
"Répertoire de données facultatif pour déduire les noms de classe depuis "
"train/"

#: mb/cli/parsing/export.py:36
msgid "Expected input image size (defaults to pipeline)"
msgstr "Taille d'image d'entrée attendue (par défaut, celle du pipeline)"

#: mb/cli/parsing/export.py:37
msgid "Optional snapshot JSON path"
msgstr "Chemin JSON d'instantané facultatif"

#: mb/cli/parsing/export.py:41
msgid "Do not emit model_architecture.py stub"
msgstr "Ne pas émettre l'ébauche model_architecture.py"

#: mb/cli/parsing/export.py:43
msgid "Optional run ID to include in manifest"
msgstr "ID d'exécution facultatif à inclure dans le manifeste"

#: mb/cli/parsing/info.py:15
msgid "Show information about models or datasets"
msgstr "Afficher des informations sur les modèles ou les jeux de données"

#: mb/cli/parsing/info.py:17
msgid ""
"Display information about trained models or datasets, including metadata, "
"architecture details, and dataset statistics."
msgstr ""
"Affiche des informations sur les modèles entraînés ou les jeux de données, y"
" compris les métadonnées, les détails d'architecture et les statistiques du "
"jeu de données."

#: mb/cli/parsing/info.py:23
msgid "Info subcommands"
msgstr "Sous-commandes d'information"

#: mb/cli/parsing/info.py:30
msgid "Show model information"
msgstr "Afficher les informations du modèle"

#: mb/cli/parsing/info.py:32
msgid ""
"Display detailed information about a trained model, including architecture, "
"framework, number of parameters, and training metadata."
msgstr ""
"Affiche des informations détaillées sur un modèle entraîné, notamment "
"l'architecture, le framework, le nombre de paramètres et les métadonnées "
"d'entraînement."

#: mb/cli/parsing/info.py:40
msgid "Path to model file"
msgstr "Chemin du fichier de modèle"

#: mb/cli/parsing/info.py:46
msgid "Show dataset information"
msgstr "Afficher les informations du jeu de données"

#: mb/cli/parsing/info.py:48
msgid ""
"Display statistics about a dataset, including class distributions, image "
"counts, and data directory structure."
msgstr ""
"Affiche des statistiques sur un jeu de données, notamment les distributions "
"de classes, les nombres d'images et la structure du répertoire de données."

#: mb/cli/parsing/info.py:56
msgid "Path to data directory"
msgstr "Chemin du répertoire de données"

#: mb/cli/parsing/model_convert.py:15
msgid "Convert model between formats"
msgstr "Convertir le modèle entre des formats"

#: mb/cli/parsing/model_convert.py:17
msgid ""
"Convert a trained model between different formats. Supports PyTorch -> ONNX,"
" PyTorch -> SafeTensors, and Keras -> ONNX."
msgstr ""
"Convertit un modèle entraîné entre différents formats. Prend en charge "
"PyTorch -> ONNX, PyTorch -> SafeTensors et Keras -> ONNX."

#: mb/cli/parsing/model_convert.py:25
msgid "Input model file"
msgstr "Fichier de modèle en entrée"

#: mb/cli/parsing/model_convert.py:31
msgid "Output model file"
msgstr "Fichier de modèle en sortie"

#: mb/cli/parsing/model_convert.py:36
msgid "Source framework (auto-detected if not specified)"
msgstr "Framework source (détecté automatiquement s'il n'est pas précisé)"

#: mb/cli/parsing/model_convert.py:42
msgid "Target format (onnx or safetensors)"
msgstr "Format cible (onnx ou safetensors)"

#: mb/cli/parsing/model_convert.py:46
msgid ""
"Model architecture (required for PyTorch -> ONNX conversion, e.g., "
"'resnet34')"
msgstr ""
"Architecture du modèle (requise pour la conversion de PyTorch -> ONNX, p. "
"ex. 'resnet34')"

#: mb/cli/parsing/model_convert.py:51
msgid "Number of output classes (required for PyTorch -> ONNX conversion)"
msgstr ""
"Nombre de classes de sortie (requis pour la conversion de PyTorch -> ONNX)"

#: mb/cli/parsing/model_convert.py:57
msgid "Input image size (default: 224, used for ONNX conversion)"
msgstr ""
"Taille de l'image d'entrée (par défaut : 224, utilisée pour la conversion "
"ONNX)"

#: mb/cli/parsing/model_convert.py:63
msgid ""
"Class names in output-index order, recorded in the ONNX file's metadata so "
"consumers do not have to be told the label order separately"
msgstr ""
"Noms de classe dans l'ordre des indices de sortie, enregistrés dans les "
"métadonnées du fichier ONNX afin que les consommateurs n'aient pas à se "
"faire indiquer séparément l'ordre des étiquettes"

#: mb/cli/parsing/model_convert.py:72
msgid ""
"Also write quantized ONNX variants alongside the output (e.g. --quantize "
"fp16 int8). Smaller and faster at some cost in accuracy — score them before "
"deploying."
msgstr ""
"Écrire aussi des variantes ONNX quantifiées à côté de la sortie (p. ex. "
"--quantize fp16 int8). Plus petites et plus rapides, au prix d'une perte "
"d'exactitude - évaluez-les avant de les déployer."

#: mb/cli/parsing/train.py:17
msgid "Train a model"
msgstr "Entraîner un modèle"

#: mb/cli/parsing/train.py:19
msgid ""
"Train a machine learning model using the specified framework and "
"architecture. Supports transfer learning with frozen/unfrozen training "
"phases."
msgstr ""
"Entraîne un modèle d'apprentissage automatique avec le framework et "
"l'architecture indiqués. Prend en charge l'apprentissage par transfert, avec"
" des phases d'entraînement gelées et dégelées."

#: mb/cli/parsing/train.py:27
msgid "Model type (default: image_classification)"
msgstr "Type de modèle (par défaut : image_classification)"

#: mb/cli/parsing/train.py:32
msgid "Framework to use (default: from config)"
msgstr "Framework à utiliser (par défaut : depuis la configuration)"

#: mb/cli/parsing/train.py:37
msgid ""
"Model architecture (e.g., resnet34). For --model-type image_generation_lora,"
" this instead names the base image-generation model to fine-tune (a local "
"path or hub id, e.g. a Stable Diffusion checkpoint)."
msgstr ""
"Architecture du modèle (p. ex. resnet34). Pour --model-type "
"image_generation_lora, ceci nomme plutôt le modèle de base de génération "
"d'images à affiner (un chemin local ou un hub id, p. ex. un point de "
"contrôle Stable Diffusion)."

#: mb/cli/parsing/train.py:45
msgid "Data directory (default: from config)"
msgstr "Répertoire de données (par défaut : depuis la configuration)"

#: mb/cli/parsing/train.py:50
msgid "Output directory for models (default: from config)"
msgstr ""
"Répertoire de sortie des modèles (par défaut : depuis la configuration)"

#: mb/cli/parsing/train.py:62
msgid "Number of frozen training epochs (default: from config)"
msgstr ""
"Nombre d'époques d'entraînement gelé (par défaut : depuis la configuration)"

#: mb/cli/parsing/train.py:67
msgid "Number of unfrozen training epochs (default: from config)"
msgstr ""
"Nombre d'époques d'entraînement dégelé (par défaut : depuis la "
"configuration)"

#: mb/cli/parsing/train.py:72
msgid "Learning rate for frozen phase (default: from config)"
msgstr ""
"Taux d'apprentissage de la phase gelée (par défaut : depuis la "
"configuration)"

#: mb/cli/parsing/train.py:77
msgid "Maximum learning rate for unfrozen phase (default: from config)"
msgstr ""
"Taux d'apprentissage maximal de la phase dégelée (par défaut : depuis la "
"configuration)"

#: mb/cli/parsing/train.py:82
msgid "Minimum learning rate for unfrozen phase (default: from config)"
msgstr ""
"Taux d'apprentissage minimal de la phase dégelée (par défaut : depuis la "
"configuration)"

#: mb/cli/parsing/train.py:80
msgid "Batch size (default: from config or auto-detect)"
msgstr ""
"Taille du lot (par défaut : depuis la configuration ou détection "
"automatique)"

#: mb/cli/parsing/train.py:96
msgid ""
"Image size (default: 224). For --model-type image_generation_lora, this is "
"the training resolution instead (default: 512)."
msgstr ""
"Taille de l'image (par défaut : 224). Pour --model-type "
"image_generation_lora, il s'agit plutôt de la résolution d'entraînement (par"
" défaut : 512)."

#: mb/cli/parsing/train.py:103
msgid "Number of data loading workers (default: from config)"
msgstr ""
"Nombre de processus de chargement des données (par défaut : depuis la "
"configuration)"

#: mb/cli/parsing/train.py:109
msgid ""
"Whether an image carries one class or several (image_classification only; "
"default: from config, which ships as single_label). multi_label reads "
"label_schema.json and labels.jsonl beside the dataset and trains independent"
" per-label sigmoids. PyTorch only."
msgstr ""
"Indique si une image porte une classe ou plusieurs (image_classification "
"uniquement ; par défaut : depuis la configuration, qui est livrée en "
"single_label). multi_label lit label_schema.json et labels.jsonl à côté du "
"jeu de données et entraîne des sigmoïdes indépendantes par étiquette. "
"PyTorch uniquement."

#: mb/cli/parsing/train.py:119
msgid ""
"Train at --image-size even when the architecture expects a different one. "
"Only affects backbones with a fixed input resolution (e.g. siglip2_*), where"
" a mismatch means the pretrained position embeddings no longer line up."
msgstr ""
"Entraîner avec --image-size même si l'architecture en attend une autre. "
"N'affecte que les backbones à résolution d'entrée fixe (p. ex. siglip2_*), "
"où un écart fait que les plongements de position préentraînés ne s'alignent "
"plus."

#: mb/cli/parsing/train.py:128
msgid ""
"Compensate an imbalanced training set by weighting the training loss "
"(image_classification only; default: from config). Validation loss stays "
"unweighted so it remains comparable across settings."
msgstr ""
"Compenser un jeu de données d'entraînement déséquilibré en appliquant des "
"poids à la perte d'entraînement (image_classification uniquement ; par "
"défaut : depuis la configuration). La perte de validation reste sans poids "
"afin de rester comparable d'un réglage à l'autre."

#: mb/cli/parsing/train.py:137
msgid ""
"Ceiling on any single class weight (--class-weighting inverse_frequency "
"only; default: from config)"
msgstr ""
"Plafond du poids d'une seule classe (--class-weighting inverse_frequency "
"uniquement ; par défaut : depuis la configuration)"

#: mb/cli/parsing/train.py:135
msgid ""
"Random seed. Currently only consumed by --model-type image_generation_lora "
"(reproducible LoRA weight init and noise sampling)."
msgstr ""
"Graine aléatoire. Actuellement utilisée seulement par --model-type "
"image_generation_lora (initialisation reproductible des poids LoRA et "
"échantillonnage du bruit)."

#: mb/cli/parsing/train.py:153
msgid ""
"LoRA adapter rank (--model-type image_generation_lora only; default: 16)"
msgstr ""
"Rang de l'adaptateur LoRA (--model-type image_generation_lora uniquement ; "
"par défaut : 16)"

#: mb/cli/parsing/train.py:159
msgid ""
"LoRA adapter alpha scaling (--model-type image_generation_lora only; "
"default: same as --lora-rank)"
msgstr ""
"Mise à l'échelle alpha de l'adaptateur LoRA (--model-type "
"image_generation_lora uniquement ; par défaut : identique à --lora-rank)"

#: mb/cli/parsing/train.py:156
msgid ""
"Learning rate for the LoRA adapter parameters (--model-type "
"image_generation_lora only; default: 1e-4). Unrelated to --frozen-"
"lr/--unfrozen-lr-* (image_classification only)."
msgstr ""
"Taux d'apprentissage des paramètres de l'adaptateur LoRA (--model-type "
"image_generation_lora uniquement ; par défaut : 1e-4). Sans lien avec "
"--frozen-lr/--unfrozen-lr-* (image_classification uniquement)."

#: mb/cli/parsing/train.py:177
msgid ""
"Total optimizer steps to train (--model-type image_generation_lora only; "
"default: 1000). LoRA training here is step-based, not epoch-based."
msgstr ""
"Nombre total de pas de l'optimiseur pour l'entraînement (--model-type "
"image_generation_lora uniquement ; par défaut : 1000). Ici, l'entraînement "
"LoRA se compte en pas, et non en époques."

#: mb/cli/parsing/train.py:186
msgid ""
"--model-type image_generation_lora only: the base model's architecture "
"(different architectures load different components and LoRA target layers). "
"Auto-detected from a local checkpoint's model_index.json when omitted; "
"required when --architecture is a hub id rather than a local path, since "
"that can't be auto-detected without a network call. flux (recommended "
"default), chroma, and stable_diffusion_1x are implemented today — "
"stable_diffusion_xl, stable_diffusion_3, and z_image_turbo are recognized "
"but not yet supported."
msgstr ""
"--model-type image_generation_lora uniquement : architecture du modèle de "
"base (des architectures différentes chargent des composants différents et "
"des couches cibles LoRA différentes). Détection automatique depuis le "
"model_index.json d'un point de contrôle local en cas d'omission ; "
"obligatoire lorsque --architecture est un hub id plutôt qu'un chemin local, "
"car la détection automatique est impossible sans appel réseau. flux (valeur "
"par défaut recommandée), chroma et stable_diffusion_1x sont implémentés "
"aujourd'hui - stable_diffusion_xl, stable_diffusion_3 et z_image_turbo sont "
"reconnus, mais pas encore pris en charge."

#: mb/cli/parsing/train.py:226
msgid "Path to checkpoint to resume training from"
msgstr "Chemin du point de contrôle pour reprendre l'entraînement"

#: mb/cli/parsing/train.py:236
msgid "Skip updating the unified snapshot with training data"
msgstr ""
"Ne pas mettre à jour l'instantané unifié avec les données d'entraînement"

#: mb/cli/parsing/train.py:243
msgid ""
"Load TrainingRunArgs from JSON (see mb.training.run_args); other train flags"
" are ignored"
msgstr ""
"Charger TrainingRunArgs depuis JSON (voir mb.training.run_args) ; les autres"
" options de train sont ignorées"

