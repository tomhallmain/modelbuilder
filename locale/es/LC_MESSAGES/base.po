#: mb/cli/parsing/data.py:18
msgid "Data processing operations"
msgstr "Operaciones de procesamiento de datos"

#: mb/cli/parsing/data.py:19
msgid "Data processing operations for preparing image datasets"
msgstr ""
"Operaciones de procesamiento de datos para preparar conjuntos de datos de "
"imágenes"

#: mb/cli/parsing/data.py:23
msgid "Data subcommands"
msgstr "Subcomandos de datos"

#: mb/cli/parsing/data.py:30
msgid "Gather images from source directories"
msgstr "Reunir imágenes de los directorios de origen"

#: mb/cli/parsing/data.py:32
msgid ""
"Gather images from source directories into a target directory, with "
"deduplication and optional weighting by subdirectory."
msgstr ""
"Reúne imágenes de los directorios de origen en un directorio de destino, con"
" deduplicación y una ponderación opcional por subdirectorio."

#: mb/cli/parsing/data.py:40
msgid "Source directory containing images"
msgstr "Directorio de origen con las imágenes"

#: mb/cli/parsing/data.py:46
msgid "Subdirectories to process"
msgstr "Subdirectorios que se procesarán"

#: mb/cli/parsing/data.py:53
msgid ""
"Target number of images to gather (default: from pipeline "
"data.gather.default_target_count). Treated as a limit, not an exact "
"requirement."
msgstr ""
"Número objetivo de imágenes que se reunirán (predeterminado: de la "
"canalización, data.gather.default_target_count). Se trata como un límite, no"
" como una cantidad exacta."

#: mb/cli/parsing/data.py:61
msgid ""
"Target directory for gathered images (default: from pipeline "
"data.gather.default_target_dir)"
msgstr ""
"Directorio de destino de las imágenes reunidas (predeterminado: de la "
"canalización, data.gather.default_target_dir)"

#: mb/cli/parsing/data.py:67
msgid ""
"Rejected directory for manually rejected images (default: "
"data.gather.default_rejected_dir)"
msgstr ""
"Directorio de rechazos para las imágenes rechazadas manualmente "
"(predeterminado: data.gather.default_rejected_dir)"

#: mb/cli/parsing/data.py:73
msgid ""
"Relative weights for subdirectories: \"subdir1:weight1,subdir2:weight2\" "
"(e.g. \"neutral:4,drawing:1\" ≈ 80%%/20%%, or \"neutral:0.8,drawing:0.2\"). "
"Weights are normalized automatically; any positive numbers work."
msgstr ""
"Pesos relativos de los subdirectorios: \"subdir1:weight1,subdir2:weight2\" "
"(p. ej. \"neutral:4,drawing:1\" ~ 80%%/20%%, o \"neutral:0.8,drawing:0.2\")."
" Los pesos se normalizan automáticamente; cualquier número positivo sirve."

#: mb/cli/parsing/data.py:82
msgid ""
"Root directory for raw data (default: data.raw_data_dir in pipeline config)"
msgstr ""
"Directorio raíz de los datos en bruto (predeterminado: data.raw_data_dir en "
"la configuración de la canalización)"

#: mb/cli/parsing/data.py:89
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, gather also considers configured video extensions."
msgstr ""
"Tipo de modelo de la canalización (predeterminado: model.default_type). Con "
"image_classification, la reunión también tiene en cuenta las extensiones de "
"vídeo configuradas."

#: mb/cli/parsing/data.py:97
msgid "Convert images to specified format"
msgstr "Convertir imágenes al formato indicado"

#: mb/cli/parsing/data.py:99
msgid ""
"Convert images in the raw data directory to a specified format (e.g., JPEG)."
" Large images are automatically resized to prevent memory issues."
msgstr ""
"Convierte las imágenes del directorio de datos en bruto al formato indicado "
"(p. ej., JPEG). Las imágenes grandes se redimensionan automáticamente para "
"evitar problemas de memoria."

#: mb/cli/parsing/data.py:107 mb/cli/parsing/data.py:194
#: mb/cli/parsing/data.py:220 mb/cli/parsing/data.py:413
msgid "Raw data directory (default: raw_data)"
msgstr "Directorio de datos sin procesar (predeterminado: raw_data)"

#: mb/cli/parsing/data.py:114
msgid ""
"Target format for converted outputs (default: jpeg). The converter is "
"currently JPEG-oriented; non-default values may be ignored until "
"implemented."
msgstr ""
"Formato de destino de las salidas convertidas (predeterminado: jpeg). El "
"conversor está orientado a JPEG por ahora; los valores distintos del "
"predeterminado pueden ignorarse hasta que se implementen."

#: mb/cli/parsing/data.py:123
msgid ""
"Pipeline model type (default: model.default_type). When "
"image_classification, videos and multi-frame GIFs get a random frame as "
"JPEG."
msgstr ""
"Tipo de modelo de la canalización (predeterminado: model.default_type). "
"Cuando es image_classification, los vídeos y los GIF de varios fotogramas "
"obtienen un fotograma aleatorio como JPEG."

#: mb/cli/parsing/data.py:131
msgid ""
"Allow convert to run even if the raw-data drive appears to have insufficient"
" free space (heuristic estimate; not recommended)."
msgstr ""
"Permitir que convert se ejecute aunque la unidad de datos sin procesar "
"parezca no tener espacio libre suficiente (estimación heurística; no "
"recomendado)."

#: mb/cli/parsing/data.py:140
msgid ""
"Unified snapshot run ID to update (snapshot_<run_id>.json under raw data). "
"Omit to start a new snapshot with a new run ID."
msgstr ""
"ID de ejecución de la instantánea unificada que se actualizará "
"(snapshot_<run_id>.json bajo los datos sin procesar). Omítalo para iniciar "
"una instantánea nueva con un ID de ejecución nuevo."

#: mb/cli/parsing/data.py:148
msgid "Remove duplicate images"
msgstr "Quitar imágenes duplicadas"

#: mb/cli/parsing/data.py:150
msgid ""
"Remove duplicate images within and across class directories. Uses perceptual"
" hashing to identify duplicates and moves them to a review directory."
msgstr ""
"Quita imágenes duplicadas dentro de los directorios de clase y entre ellos. "
"Usa un hash perceptual para identificar duplicados y los mueve a un "
"directorio de revisión."

#: mb/cli/parsing/data.py:159
msgid ""
"Root raw data directory containing class subdirectories (default: raw_data)."
" Typical layouts include multiple class folders under this root."
msgstr ""
"Directorio raíz de datos sin procesar que contiene subdirectorios de clase "
"(predeterminado: raw_data). Las disposiciones habituales incluyen varias "
"carpetas de clase bajo esta raíz."

#: mb/cli/parsing/data.py:167
msgid ""
"Scan and print duplicate groups as indented JSON (no removals). Useful for "
"manual review workflows."
msgstr ""
"Examina e imprime los grupos de duplicados como JSON con sangría (sin "
"eliminaciones). Útil para flujos de revisión manual."

#: mb/cli/parsing/data.py:176
msgid ""
"Optional unified snapshot run ID to update with deduplication metadata. If "
"omitted, the latest loadable snapshot under raw data is used when available."
msgstr ""
"ID de ejecución opcional de la instantánea unificada que se actualizará con "
"metadatos de desduplicación. Si se omite, se usa la instantánea cargable más"
" reciente bajo los datos sin procesar cuando esté disponible."

#: mb/cli/parsing/data.py:184
msgid "Upscale small images"
msgstr "Ampliar imágenes pequeñas"

#: mb/cli/parsing/data.py:186
msgid ""
"Upscale images that are smaller than a minimum dimension threshold. Small "
"images are moved to a review directory for manual inspection before "
"upscaling."
msgstr ""
"Amplía las imágenes menores que un umbral de dimensión mínima. Las imágenes "
"pequeñas se mueven a un directorio de revisión para inspección manual antes "
"de ampliarlas."

#: mb/cli/parsing/data.py:200
msgid ""
"Review directory containing small images to upscale (default: <raw-data-"
"dir>/small_images_review). Upscaled outputs go under <review-"
"dir>/upscaled_small_images."
msgstr ""
"Directorio de revisión con las imágenes pequeñas que se ampliarán "
"(predeterminado: <raw-data-dir>/small_images_review). Las salidas ampliadas "
"quedan bajo <review-dir>/upscaled_small_images."

#: mb/cli/parsing/data.py:209
msgid "Create train/test dataset splits"
msgstr "Crear divisiones de entrenamiento y prueba del conjunto de datos"

#: mb/cli/parsing/data.py:211
msgid ""
"Create training and test dataset splits from raw data. Validates images, "
"removes corrupted files, filters by size, and creates balanced train/test "
"splits with hash-based filenames."
msgstr ""
"Crea divisiones de entrenamiento y prueba del conjunto de datos a partir de "
"los datos sin procesar. Valida las imágenes, quita los archivos dañados, "
"filtra por tamaño y crea divisiones equilibradas de entrenamiento/prueba con"
" nombres de archivo basados en un hash."

#: mb/cli/parsing/data.py:226
msgid "Output data directory (default: data)"
msgstr "Directorio de datos de salida (predeterminado: data)"

#: mb/cli/parsing/data.py:233
msgid ""
"Number of items per class in the test split when mode is fixed; also the "
"anchor for dataset-weighted mode (default: data.test_per_class from pipeline"
" YAML)."
msgstr ""
"Número de elementos por clase en la división de prueba cuando el modo es "
"fixed; también el ancla del modo dataset-weighted (predeterminado: "
"data.test_per_class del YAML de la canalización)."

#: mb/cli/parsing/data.py:242
msgid ""
"fixed = test_per_class images per class; dataset-weighted = modulated counts"
" from class size vs total (default: data.test_split_mode in pipeline YAML, "
"else fixed)."
msgstr ""
"fixed = test_per_class imágenes por clase; dataset-weighted = recuentos "
"modulados según el tamaño de la clase frente al total (predeterminado: "
"data.test_split_mode en el YAML de la canalización; si no, fixed)."

#: mb/cli/parsing/data.py:251
msgid ""
"With dataset-weighted mode: classes with fewer images than this use a "
"proportional test count; larger classes use anchor + anchor×(class_share). "
"Omit to use --test-per-class as the threshold (default: pipeline "
"data.test_small_class_threshold)."
msgstr ""
"Con el modo dataset-weighted: las clases con menos imágenes que este valor "
"usan un recuento de prueba proporcional; las clases mayores usan ancla + "
"ancla x (class_share). Omítalo para usar --test-per-class como umbral "
"(predeterminado: data.test_small_class_threshold de la canalización)."

#: mb/cli/parsing/data.py:261
msgid ""
"Random seed for reproducibility (default: data.seed from pipeline YAML when "
"set, else non-deterministic)"
msgstr ""
"Semilla aleatoria para la reproducibilidad (predeterminado: data.seed del "
"YAML de la canalización si está definida; si no, no determinista)"

#: mb/cli/parsing/data.py:267 mb/cli/parsing/train.py:231
msgid ""
"Run ID of unified snapshot to update (auto-detects latest if not provided)"
msgstr ""
"ID de ejecución de la instantánea unificada que se actualizará (si no se "
"indica, detecta automáticamente la más reciente)"

#: mb/cli/parsing/data.py:273
msgid ""
"Balance the training set to the smallest class size (default: off, keeps "
"natural proportions)."
msgstr ""
"Equilibrar el conjunto de entrenamiento al tamaño de la clase más pequeña "
"(predeterminado: off, conserva las proporciones naturales)."

#: mb/cli/parsing/data.py:280
msgid ""
"Maximum training items per class (no limit if omitted; keeps natural "
"proportions below the cap)."
msgstr ""
"Máximo de elementos de entrenamiento por clase (sin límite si se omite; por "
"debajo del tope se conservan las proporciones naturales)."

#: mb/cli/parsing/data.py:286
msgid "Allow running on external/removable storage (not recommended)"
msgstr ""
"Permitir la ejecución en almacenamiento externo o extraíble (no recomendado)"

#: mb/cli/parsing/data.py:292
msgid ""
"Allow create-dataset even if the output data drive appears to have "
"insufficient free space (heuristic estimate; not recommended)."
msgstr ""
"Permitir create-dataset aunque la unidad de datos de salida parezca no tener"
" espacio libre suficiente (estimación heurística; no recomendado)."

#: mb/cli/parsing/data.py:301
msgid ""
"Pipeline model type (default: model.default_type). image_classification "
"builds train/test ImageFolder splits from class subdirectories (all other "
"options above apply); image_generation_lora instead copies every image "
"directly under --raw-data-dir (no class folders, no train/test split) plus "
"its optional .txt caption sidecar into --data-dir, for LoRA fine-tuning of "
"an image-generation model."
msgstr ""
"Tipo de modelo de la canalización (predeterminado: model.default_type). "
"image_classification crea divisiones de entrenamiento/prueba ImageFolder a "
"partir de subdirectorios de clase (se aplican todas las demás opciones "
"anteriores); image_generation_lora, en cambio, copia en --data-dir cada "
"imagen situada directamente bajo --raw-data-dir (sin carpetas de clase ni "
"división de entrenamiento/prueba) y su archivo .txt de leyenda opcional "
"asociado, para el ajuste fino con LoRA de un modelo de generación de "
"imágenes."

#: mb/cli/parsing/data.py:312
msgid "Rename mislabeled .jpg sources and rebuild CONVERTED JPEGs"
msgstr ""
"Renombrar orígenes .jpg mal etiquetados y reconstruir los JPEG de CONVERTED"

#: mb/cli/parsing/data.py:314
msgid ""
"Finds non-JPEG bytes under .jpg/.jpeg names in class source trees (same "
"discovery as convert), writes corrected JPEGs, and removes stale copies "
"under CONVERTED and small_images_review only after a successful write. "
"Animated GIFs use the same random-frame + visual_media_review layout as "
"convert when the model type is image_classification."
msgstr ""
"Busca bytes que no son JPEG bajo nombres .jpg/.jpeg en los árboles de origen"
" de clase (el mismo descubrimiento que convert), escribe JPEG corregidos y "
"quita las copias obsoletas bajo CONVERTED y small_images_review solo después"
" de una escritura correcta. Los GIF animados usan la misma disposición de "
"fotograma aleatorio + visual_media_review que convert cuando el tipo de "
"modelo es image_classification."

#: mb/cli/parsing/data.py:325
msgid ""
"Raw data directory (default: data.raw_data_dir from the pipeline config "
"after --config; same as gather/convert when omitted)."
msgstr ""
"Directorio de datos sin procesar (predeterminado: data.raw_data_dir de la "
"configuración de la canalización tras --config; si se omite, igual que "
"gather/convert)."

#: mb/cli/parsing/data.py:332
msgid "Log planned repairs only; do not rename files or write outputs."
msgstr ""
"Registrar solo las reparaciones previstas; no renombrar archivos ni escribir"
" salidas."

#: mb/cli/parsing/data.py:339
msgid ""
"Print newline-delimited JSON (stdout): dry-run or live repair. By default "
"only actionable mismatches are listed; use -v to include policy-skipped "
"PNG/WebP/BMP/TIFF under .jpg. Live repair emits one line per successful fix "
"when applicable."
msgstr ""
"Imprime JSON delimitado por saltos de línea (stdout): simulación o "
"reparación en vivo. De forma predeterminada solo se enumeran las "
"discrepancias que se pueden corregir; use -v para incluir PNG/WebP/BMP/TIFF "
"bajo .jpg omitidos por la política. La reparación en vivo emite una línea "
"por cada corrección correcta cuando corresponde."

#: mb/cli/parsing/data.py:348
msgid ""
"With --dry-run and --json: include Pillow format and GIF metadata in each "
"JSON object."
msgstr ""
"Con --dry-run y --json: incluir el formato de Pillow y los metadatos GIF en "
"cada objeto JSON."

#: mb/cli/parsing/data.py:355
msgid ""
"With --dry-run: omit verbose per-file log lines (use with --json for "
"machine-readable output only)."
msgstr ""
"Con --dry-run: omitir las líneas de registro detalladas por archivo (úsese "
"con --json si solo se quiere una salida legible por máquina)."

#: mb/cli/parsing/data.py:364
msgid ""
"With --json: include policy-skipped static-format mismatches in JSON output."
" In text mode: log each policy-skipped file and class progress for every "
"folder; with live repair, log each skipped file. Useless with --quiet. "
"Separate from top-level mb -v (global logging)."
msgstr ""
"Con --json: incluir en la salida JSON las discrepancias de formato estático "
"omitidas por la política. En modo de texto: registrar cada archivo omitido "
"por la política y el progreso de clase de cada carpeta; con la reparación en"
" vivo, registrar cada archivo omitido. Inútil con --quiet. Independiente de "
"mb -v de nivel superior (registro global)."

#: mb/cli/parsing/data.py:374
msgid ""
"Also rename/repair mislabeled .jpg/.jpeg whose bytes are PNG, WebP, BMP, or "
"TIFF. By default those are counted and summarized per class only (GIF and "
"animated-IC cases are always repaired)."
msgstr ""
"También renombra o repara los .jpg/.jpeg mal etiquetados cuyos bytes son "
"PNG, WebP, BMP o TIFF. De forma predeterminada solo se cuentan y se resumen "
"por clase (los casos de GIF y animated-IC siempre se reparan)."

#: mb/cli/parsing/data.py:382
msgid "Pipeline model type (default: model.default_type)."
msgstr ""
"Tipo de modelo de la canalización (predeterminado: model.default_type)."

#: mb/cli/parsing/data.py:388
msgid "RNG seed for random GIF frame selection (optional)."
msgstr "Semilla para la selección aleatoria de fotogramas GIF (opcional)."

#: mb/cli/parsing/data.py:394
msgid "Estimate disk space needed for convert or create-dataset"
msgstr "Estimar el espacio en disco necesario para convert o create-dataset"

#: mb/cli/parsing/data.py:396
msgid ""
"Walks source files (same rules as convert/dataset) and compares a rough byte"
" estimate to free space on the target volume. Exits non-zero if the estimate"
" exceeds free space."
msgstr ""
"Recorre los archivos de origen (las mismas reglas que convert/dataset) y "
"compara una estimación aproximada en bytes con el espacio libre del volumen "
"de destino. Termina con un código distinto de cero si la estimación supera "
"el espacio libre."

#: mb/cli/parsing/data.py:407
msgid "Which step to estimate for"
msgstr "Paso para el que estimar"

#: mb/cli/parsing/data.py:418
msgid "Output data directory (required when operation is create-dataset)"
msgstr ""
"Directorio de datos de salida (obligatorio cuando la operación es create-"
"dataset)"

#: mb/cli/parsing/evaluate.py:16
msgid "Evaluate trained models or datasets"
msgstr "Evaluar modelos entrenados o conjuntos de datos"

#: mb/cli/parsing/evaluate.py:18
msgid ""
"Score a trained classifier on your train/test tree, surface likely labeling "
"mistakes, or compare two checkpoints on the same data."
msgstr ""
"Puntúa un clasificador entrenado en el árbol de entrenamiento/prueba, "
"muestra posibles errores de etiquetado o compara dos puntos de control con "
"los mismos datos."

#: mb/cli/parsing/evaluate.py:24
msgid "Evaluate subcommands"
msgstr "Subcomandos de evaluación"

#: mb/cli/parsing/evaluate.py:30
msgid "Compute classification metrics on a labeled split"
msgstr "Calcular métricas de clasificación en una división etiquetada"

#: mb/cli/parsing/evaluate.py:32
msgid ""
"Accuracy, confusion matrix, and per-class counts on an ImageFolder-style "
"directory (class-named subfolders of images). PyTorch requires "
"--architecture and a .pth/.pt file."
msgstr ""
"Exactitud, matriz de confusión y recuentos por clase en un directorio al "
"estilo ImageFolder (subcarpetas de imágenes con el nombre de la clase). "
"PyTorch requiere --architecture y un archivo .pth/.pt."

#: mb/cli/parsing/evaluate.py:40 mb/cli/parsing/evaluate.py:133
msgid "Path to trained model file (.pth / .pt / .h5 / .keras)"
msgstr "Ruta al archivo del modelo entrenado (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:46 mb/cli/parsing/evaluate.py:139
#: mb/cli/parsing/evaluate.py:234
msgid "ImageFolder root (e.g. .../test with one subfolder per class)"
msgstr "Raíz de ImageFolder (p. ej. .../test con una subcarpeta por clase)"

#: mb/cli/parsing/evaluate.py:52 mb/cli/parsing/evaluate.py:145
msgid "Training framework (default: infer from file extension)"
msgstr ""
"Framework de entrenamiento (predeterminado: inferir por la extensión del "
"archivo)"

#: mb/cli/parsing/evaluate.py:58 mb/cli/parsing/evaluate.py:151
msgid ""
"Model architecture id (required for PyTorch .pth checkpoints, e.g. resnet34)"
msgstr ""
"Identificador de arquitectura del modelo (obligatorio para puntos de control"
" .pth de PyTorch, p. ej. resnet34)"

#: mb/cli/parsing/evaluate.py:64 mb/cli/parsing/evaluate.py:157
#: mb/cli/parsing/evaluate.py:264
msgid "Override class count (default: infer from directory layout)"
msgstr ""
"Sustituir el número de clases (predeterminado: inferir por la disposición "
"del directorio)"

#: mb/cli/parsing/evaluate.py:70 mb/cli/parsing/evaluate.py:163
#: mb/cli/parsing/evaluate.py:270
msgid "Pipeline model type (default: image_classification)"
msgstr ""
"Tipo de modelo de la canalización (predeterminado: image_classification)"

#: mb/cli/parsing/evaluate.py:76 mb/cli/parsing/evaluate.py:169
#: mb/cli/parsing/evaluate.py:276
msgid "Square input size (default: 224)"
msgstr "Tamaño cuadrado de entrada (predeterminado: 224)"

#: mb/cli/parsing/evaluate.py:82 mb/cli/parsing/evaluate.py:175
#: mb/cli/parsing/evaluate.py:282
msgid "Batch size (default: 32)"
msgstr "Tamaño de lote (predeterminado: 32)"

#: mb/cli/parsing/evaluate.py:88 mb/cli/parsing/evaluate.py:181
#: mb/cli/parsing/evaluate.py:288
msgid "DataLoader workers for PyTorch (default: 0)"
msgstr "Procesos de DataLoader para PyTorch (predeterminado: 0)"

#: mb/cli/parsing/evaluate.py:94 mb/cli/parsing/evaluate.py:187
#: mb/cli/parsing/evaluate.py:294
msgid "PyTorch device override, e.g. cuda or cpu (default: auto)"
msgstr ""
"Sustitución del dispositivo de PyTorch, p. ej. cuda o cpu (predeterminado: "
"auto)"

#: mb/cli/parsing/evaluate.py:101
msgid ""
"How the model's output is interpreted (default: single_label). multi_label "
"reads label_schema.json beside the dataset and reports per-label metrics "
"instead of accuracy and a confusion matrix."
msgstr ""
"Cómo se interpreta la salida del modelo (predeterminado: single_label). "
"multi_label lee label_schema.json junto al conjunto de datos e informa "
"métricas por etiqueta en lugar de la exactitud y de una matriz de confusión."

#: mb/cli/parsing/evaluate.py:110
msgid ""
"--label-mode multi_label only: pick the per-label threshold that maximizes "
"each label's F1 on this split and write it back to label_schema.json. A "
"post-hoc calibration step — never run this on the training split."
msgstr ""
"Solo con --label-mode multi_label: elige el umbral por etiqueta que maximiza"
" el F1 de cada etiqueta en esta división y lo vuelve a escribir en "
"label_schema.json. Es un paso de calibración a posteriori: no lo ejecute "
"nunca en la división de entrenamiento."

#: mb/cli/parsing/evaluate.py:118 mb/cli/parsing/evaluate.py:205
#: mb/cli/parsing/evaluate.py:315
msgid "Validate arguments and exit without running inference"
msgstr "Validar los argumentos y salir sin ejecutar la inferencia"

#: mb/cli/parsing/evaluate.py:123
msgid "List images whose predicted class differs from the folder label"
msgstr ""
"Enumerar imágenes cuya clase predicha difiere de la etiqueta de la carpeta"

#: mb/cli/parsing/evaluate.py:125
msgid ""
"Compares model predictions to ImageFolder-style on-disk class folders to "
"surface label noise and borderline samples. Image classification only."
msgstr ""
"Compara las predicciones del modelo con las carpetas de clase en disco al "
"estilo ImageFolder para mostrar ruido de etiquetas y muestras en el límite. "
"Solo clasificación de imágenes."

#: mb/cli/parsing/evaluate.py:194
msgid ""
"Cap printed / exported misclassified rows (default: no cap; totals still "
"full)"
msgstr ""
"Limitar las filas mal clasificadas impresas o exportadas (predeterminado: "
"sin límite; los totales siguen completos)"

#: mb/cli/parsing/evaluate.py:200
msgid "Optional CSV path (still prints a summary to stdout)"
msgstr "Ruta CSV opcional (sigue imprimiendo un resumen en stdout)"

#: mb/cli/parsing/evaluate.py:210
msgid ""
"Compare two models on the same labeled split (paired outcomes & "
"disagreements)"
msgstr ""
"Comparar dos modelos en la misma división etiquetada (resultados emparejados"
" y desacuerdos)"

#: mb/cli/parsing/evaluate.py:212
msgid ""
"Runs both checkpoints on the same ImageFolder split in lockstep: top-1 "
"accuracy each, a 2×2-style breakdown (both correct, only A, only B, both "
"wrong vs folder labels), and how often A and B disagree on the predicted "
"class. PyTorch and Keras supported when both files use the same framework."
msgstr ""
"Ejecuta ambos puntos de control a la vez en la misma división ImageFolder: "
"exactitud top-1 de cada uno, un desglose al estilo 2x2 (ambos correctos, "
"solo A, solo B, ambos incorrectos frente a las etiquetas de la carpeta) y la"
" frecuencia con la que A y B no coinciden en la clase predicha. Se admiten "
"PyTorch y Keras cuando ambos archivos usan el mismo framework."

#: mb/cli/parsing/evaluate.py:222
msgid "Path to first model file (.pth / .pt / .h5 / .keras)"
msgstr "Ruta al archivo del primer modelo (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:228
msgid "Path to second model file (.pth / .pt / .h5 / .keras)"
msgstr "Ruta al archivo del segundo modelo (.pth / .pt / .h5 / .keras)"

#: mb/cli/parsing/evaluate.py:240
msgid ""
"Training framework hint for both models (default: infer from each file)"
msgstr ""
"Indicación del framework de entrenamiento para ambos modelos "
"(predeterminado: inferir a partir de cada archivo)"

#: mb/cli/parsing/evaluate.py:246
msgid ""
"Optional framework hint for model B only (default: same as --framework)"
msgstr ""
"Indicación opcional de framework solo para el modelo B (predeterminado: "
"igual que --framework)"

#: mb/cli/parsing/evaluate.py:252
msgid "Model architecture id for PyTorch model A (e.g. resnet34)"
msgstr ""
"Identificador de arquitectura del modelo A de PyTorch (p. ej. resnet34)"

#: mb/cli/parsing/evaluate.py:258
msgid ""
"Architecture for PyTorch model B when it differs from model A (default: "
"--architecture)"
msgstr ""
"Arquitectura del modelo B de PyTorch cuando difiere del modelo A "
"(predeterminado: --architecture)"

#: mb/cli/parsing/evaluate.py:302
msgid ""
"Cap printed / exported rows where A and B disagree on class (default: no "
"cap; totals still full)"
msgstr ""
"Limitar las filas impresas o exportadas en las que A y B no coinciden en la "
"clase (predeterminado: sin límite; los totales siguen completos)"

#: mb/cli/parsing/evaluate.py:310
msgid ""
"Optional TSV path for disagreement rows (summary still prints to stdout)"
msgstr ""
"Ruta TSV opcional para las filas de desacuerdo (el resumen se sigue "
"imprimiendo en stdout)"

#: mb/cli/parsing/export.py:15
msgid "Export model bundle artifacts"
msgstr "Exportar artefactos del paquete del modelo"

#: mb/cli/parsing/export.py:17
msgid ""
"Export deployment bundle artifacts such as safetensors weights and metadata "
"manifests."
msgstr ""
"Exporta artefactos del paquete de implementación, como pesos safetensors y "
"manifiestos de metadatos."

#: mb/cli/parsing/export.py:22
msgid "Export subcommands"
msgstr "Subcomandos de exportación"

#: mb/cli/parsing/export.py:28
msgid ""
"Export a model bundle (safetensors + manifest + optional architecture stub)"
msgstr ""
"Exportar un paquete de modelo (safetensors + manifiesto + archivo auxiliar "
"de arquitectura opcional)"

#: mb/cli/parsing/export.py:30
msgid "Input model file (.pth/.pt)"
msgstr "Archivo de modelo de entrada (.pth/.pt)"

#: mb/cli/parsing/export.py:31
msgid "Output bundle directory"
msgstr "Directorio del paquete de salida"

#: mb/cli/parsing/export.py:32
msgid "Model architecture id (e.g. resnet34)"
msgstr "Identificador de arquitectura del modelo (p. ej. resnet34)"

#: mb/cli/parsing/export.py:33
msgid "Number of output classes"
msgstr "Número de clases de salida"

#: mb/cli/parsing/export.py:34
msgid "Optional ordered class names"
msgstr "Nombres de clase ordenados opcionales"

#: mb/cli/parsing/export.py:35
msgid "Optional data dir to infer class names from train/"
msgstr ""
"Directorio de datos opcional para inferir los nombres de clase desde train/"

#: mb/cli/parsing/export.py:36
msgid "Expected input image size (defaults to pipeline)"
msgstr ""
"Tamaño de imagen de entrada esperado (de forma predeterminada, el de la "
"canalización)"

#: mb/cli/parsing/export.py:37
msgid "Optional snapshot JSON path"
msgstr "Ruta JSON de instantánea opcional"

#: mb/cli/parsing/export.py:41
msgid "Do not emit model_architecture.py stub"
msgstr "No generar el archivo auxiliar model_architecture.py"

#: mb/cli/parsing/export.py:43
msgid "Optional run ID to include in manifest"
msgstr "ID de ejecución opcional para incluir en el manifiesto"

#: mb/cli/parsing/info.py:15
msgid "Show information about models or datasets"
msgstr "Mostrar información sobre modelos o conjuntos de datos"

#: mb/cli/parsing/info.py:17
msgid ""
"Display information about trained models or datasets, including metadata, "
"architecture details, and dataset statistics."
msgstr ""
"Muestra información sobre modelos entrenados o conjuntos de datos, incluidos"
" metadatos, detalles de arquitectura y estadísticas del conjunto de datos."

#: mb/cli/parsing/info.py:23
msgid "Info subcommands"
msgstr "Subcomandos de información"

#: mb/cli/parsing/info.py:30
msgid "Show model information"
msgstr "Mostrar información del modelo"

#: mb/cli/parsing/info.py:32
msgid ""
"Display detailed information about a trained model, including architecture, "
"framework, number of parameters, and training metadata."
msgstr ""
"Muestra información detallada de un modelo entrenado, incluida la "
"arquitectura, el framework, el número de parámetros y los metadatos de "
"entrenamiento."

#: mb/cli/parsing/info.py:40
msgid "Path to model file"
msgstr "Ruta al archivo del modelo"

#: mb/cli/parsing/info.py:46
msgid "Show dataset information"
msgstr "Mostrar información del conjunto de datos"

#: mb/cli/parsing/info.py:48
msgid ""
"Display statistics about a dataset, including class distributions, image "
"counts, and data directory structure."
msgstr ""
"Muestra estadísticas de un conjunto de datos, incluidas las distribuciones "
"de clases, los recuentos de imágenes y la estructura del directorio de "
"datos."

#: mb/cli/parsing/info.py:56
msgid "Path to data directory"
msgstr "Ruta al directorio de datos"

#: mb/cli/parsing/model_convert.py:15
msgid "Convert model between formats"
msgstr "Convertir el modelo entre formatos"

#: mb/cli/parsing/model_convert.py:17
msgid ""
"Convert a trained model between different formats. Supports PyTorch -> ONNX,"
" PyTorch -> SafeTensors, and Keras -> ONNX."
msgstr ""
"Convierte un modelo entrenado entre distintos formatos. Admite PyTorch -> "
"ONNX, PyTorch -> SafeTensors y Keras -> ONNX."

#: mb/cli/parsing/model_convert.py:25
msgid "Input model file"
msgstr "Archivo de modelo de entrada"

#: mb/cli/parsing/model_convert.py:31
msgid "Output model file"
msgstr "Archivo de modelo de salida"

#: mb/cli/parsing/model_convert.py:36
msgid "Source framework (auto-detected if not specified)"
msgstr "Framework de origen (se detecta automáticamente si no se especifica)"

#: mb/cli/parsing/model_convert.py:42
msgid "Target format (onnx or safetensors)"
msgstr "Formato de destino (onnx o safetensors)"

#: mb/cli/parsing/model_convert.py:46
msgid ""
"Model architecture (required for PyTorch -> ONNX conversion, e.g., "
"'resnet34')"
msgstr ""
"Arquitectura del modelo (obligatoria para la conversión de PyTorch -> ONNX, "
"p. ej., 'resnet34')"

#: mb/cli/parsing/model_convert.py:51
msgid "Number of output classes (required for PyTorch -> ONNX conversion)"
msgstr ""
"Número de clases de salida (obligatorio para la conversión de PyTorch -> "
"ONNX)"

#: mb/cli/parsing/model_convert.py:57
msgid "Input image size (default: 224, used for ONNX conversion)"
msgstr ""
"Tamaño de la imagen de entrada (predeterminado: 224, se usa en la conversión"
" a ONNX)"

#: mb/cli/parsing/model_convert.py:63
msgid ""
"Class names in output-index order, recorded in the ONNX file's metadata so "
"consumers do not have to be told the label order separately"
msgstr ""
"Nombres de clase en el orden del índice de salida, registrados en los "
"metadatos del archivo ONNX para que los consumidores no necesiten que se les"
" indique aparte el orden de las etiquetas"

#: mb/cli/parsing/model_convert.py:72
msgid ""
"Also write quantized ONNX variants alongside the output (e.g. --quantize "
"fp16 int8). Smaller and faster at some cost in accuracy — score them before "
"deploying."
msgstr ""
"Escribir también variantes ONNX cuantizadas junto a la salida (p. ej. "
"--quantize fp16 int8). Son más pequeñas y más rápidas, con cierto coste de "
"exactitud - evalúelas antes de desplegarlas."

#: mb/cli/parsing/train.py:17
msgid "Train a model"
msgstr "Entrenar un modelo"

#: mb/cli/parsing/train.py:19
msgid ""
"Train a machine learning model using the specified framework and "
"architecture. Supports transfer learning with frozen/unfrozen training "
"phases."
msgstr ""
"Entrena un modelo de aprendizaje automático con el framework y la "
"arquitectura indicados. Admite aprendizaje por transferencia con fases de "
"entrenamiento congeladas y descongeladas."

#: mb/cli/parsing/train.py:27
msgid "Model type (default: image_classification)"
msgstr "Tipo de modelo (predeterminado: image_classification)"

#: mb/cli/parsing/train.py:32
msgid "Framework to use (default: from config)"
msgstr "Framework a usar (predeterminado: desde la configuración)"

#: mb/cli/parsing/train.py:37
msgid ""
"Model architecture (e.g., resnet34). For --model-type image_generation_lora,"
" this instead names the base image-generation model to fine-tune (a local "
"path or hub id, e.g. a Stable Diffusion checkpoint)."
msgstr ""
"Arquitectura del modelo (p. ej., resnet34). Con --model-type "
"image_generation_lora, este valor indica en su lugar el modelo base de "
"generación de imágenes que se va a afinar (una ruta local o un hub id, p. "
"ej. un punto de control de Stable Diffusion)."

#: mb/cli/parsing/train.py:45
msgid "Data directory (default: from config)"
msgstr "Directorio de datos (predeterminado: desde la configuración)"

#: mb/cli/parsing/train.py:50
msgid "Output directory for models (default: from config)"
msgstr ""
"Directorio de salida de los modelos (predeterminado: desde la configuración)"

#: mb/cli/parsing/train.py:62
msgid "Number of frozen training epochs (default: from config)"
msgstr ""
"Número de épocas de entrenamiento congelado (predeterminado: desde la "
"configuración)"

#: mb/cli/parsing/train.py:67
msgid "Number of unfrozen training epochs (default: from config)"
msgstr ""
"Número de épocas de entrenamiento descongelado (predeterminado: desde la "
"configuración)"

#: mb/cli/parsing/train.py:72
msgid "Learning rate for frozen phase (default: from config)"
msgstr ""
"Tasa de aprendizaje de la fase congelada (predeterminado: desde la "
"configuración)"

#: mb/cli/parsing/train.py:77
msgid "Maximum learning rate for unfrozen phase (default: from config)"
msgstr ""
"Tasa de aprendizaje máxima de la fase descongelada (predeterminado: desde la"
" configuración)"

#: mb/cli/parsing/train.py:82
msgid "Minimum learning rate for unfrozen phase (default: from config)"
msgstr ""
"Tasa de aprendizaje mínima de la fase descongelada (predeterminado: desde la"
" configuración)"

#: mb/cli/parsing/train.py:80
msgid "Batch size (default: from config or auto-detect)"
msgstr ""
"Tamaño del lote (predeterminado: desde la configuración o detección "
"automática)"

#: mb/cli/parsing/train.py:96
msgid ""
"Image size (default: 224). For --model-type image_generation_lora, this is "
"the training resolution instead (default: 512)."
msgstr ""
"Tamaño de imagen (predeterminado: 224). Con --model-type "
"image_generation_lora, es en su lugar la resolución de entrenamiento "
"(predeterminado: 512)."

#: mb/cli/parsing/train.py:103
msgid "Number of data loading workers (default: from config)"
msgstr ""
"Número de procesos de carga de datos (predeterminado: desde la "
"configuración)"

#: mb/cli/parsing/train.py:109
msgid ""
"Whether an image carries one class or several (image_classification only; "
"default: from config, which ships as single_label). multi_label reads "
"label_schema.json and labels.jsonl beside the dataset and trains independent"
" per-label sigmoids. PyTorch only."
msgstr ""
"Si una imagen tiene una clase o varias (solo image_classification; "
"predeterminado: desde la configuración, que se entrega como single_label). "
"multi_label lee label_schema.json y labels.jsonl junto al conjunto de datos "
"y entrena sigmoides independientes por etiqueta. Solo PyTorch."

#: mb/cli/parsing/train.py:119
msgid ""
"Train at --image-size even when the architecture expects a different one. "
"Only affects backbones with a fixed input resolution (e.g. siglip2_*), where"
" a mismatch means the pretrained position embeddings no longer line up."
msgstr ""
"Entrenar con --image-size aunque la arquitectura espere otro tamaño. Solo "
"afecta a los backbones con resolución de entrada fija (p. ej. siglip2_*), "
"donde un desajuste hace que los embeddings de posición preentrenados dejen "
"de alinearse."

#: mb/cli/parsing/train.py:128
msgid ""
"Compensate an imbalanced training set by weighting the training loss "
"(image_classification only; default: from config). Validation loss stays "
"unweighted so it remains comparable across settings."
msgstr ""
"Compensar un conjunto de datos de entrenamiento desequilibrado aplicando "
"pesos a la pérdida de entrenamiento (solo image_classification; "
"predeterminado: desde la configuración). La pérdida de validación permanece "
"sin pesos para que siga siendo comparable entre ajustes."

#: mb/cli/parsing/train.py:137
msgid ""
"Ceiling on any single class weight (--class-weighting inverse_frequency "
"only; default: from config)"
msgstr ""
"Techo del peso de una sola clase (solo --class-weighting inverse_frequency; "
"predeterminado: desde la configuración)"

#: mb/cli/parsing/train.py:135
msgid ""
"Random seed. Currently only consumed by --model-type image_generation_lora "
"(reproducible LoRA weight init and noise sampling)."
msgstr ""
"Semilla aleatoria. Actualmente solo la consume --model-type "
"image_generation_lora (inicialización reproducible de los pesos LoRA y "
"muestreo del ruido)."

#: mb/cli/parsing/train.py:153
msgid ""
"LoRA adapter rank (--model-type image_generation_lora only; default: 16)"
msgstr ""
"Rango del adaptador LoRA (solo --model-type image_generation_lora; "
"predeterminado: 16)"

#: mb/cli/parsing/train.py:159
msgid ""
"LoRA adapter alpha scaling (--model-type image_generation_lora only; "
"default: same as --lora-rank)"
msgstr ""
"Escala alfa del adaptador LoRA (solo --model-type image_generation_lora; "
"predeterminado: igual que --lora-rank)"

#: mb/cli/parsing/train.py:156
msgid ""
"Learning rate for the LoRA adapter parameters (--model-type "
"image_generation_lora only; default: 1e-4). Unrelated to --frozen-"
"lr/--unfrozen-lr-* (image_classification only)."
msgstr ""
"Tasa de aprendizaje de los parámetros del adaptador LoRA (solo --model-type "
"image_generation_lora; predeterminado: 1e-4). No está relacionada con "
"--frozen-lr/--unfrozen-lr-* (solo image_classification)."

#: mb/cli/parsing/train.py:177
msgid ""
"Total optimizer steps to train (--model-type image_generation_lora only; "
"default: 1000). LoRA training here is step-based, not epoch-based."
msgstr ""
"Pasos totales del optimizador para el entrenamiento (solo --model-type "
"image_generation_lora; predeterminado: 1000). Aquí el entrenamiento LoRA se "
"cuenta por pasos, no por épocas."

#: mb/cli/parsing/train.py:186
msgid ""
"--model-type image_generation_lora only: the base model's architecture "
"(different architectures load different components and LoRA target layers). "
"Auto-detected from a local checkpoint's model_index.json when omitted; "
"required when --architecture is a hub id rather than a local path, since "
"that can't be auto-detected without a network call. flux (recommended "
"default), chroma, and stable_diffusion_1x are implemented today — "
"stable_diffusion_xl, stable_diffusion_3, and z_image_turbo are recognized "
"but not yet supported."
msgstr ""
"--model-type image_generation_lora solamente: la arquitectura del modelo "
"base (arquitecturas distintas cargan componentes distintos y capas objetivo "
"de LoRA distintas). Se detecta automáticamente a partir del model_index.json"
" de un punto de control local cuando se omite; es obligatoria cuando "
"--architecture es un hub id y no una ruta local, ya que no se puede detectar"
" automáticamente sin una llamada de red. flux (valor predeterminado "
"recomendado), chroma y stable_diffusion_1x están implementados hoy - "
"stable_diffusion_xl, stable_diffusion_3 y z_image_turbo se reconocen, pero "
"aún no se admiten."

#: mb/cli/parsing/train.py:226
msgid "Path to checkpoint to resume training from"
msgstr "Ruta del punto de control desde el que reanudar el entrenamiento"

#: mb/cli/parsing/train.py:236
msgid "Skip updating the unified snapshot with training data"
msgstr ""
"Omitir la actualización de la instantánea unificada con los datos de "
"entrenamiento"

#: mb/cli/parsing/train.py:243
msgid ""
"Load TrainingRunArgs from JSON (see mb.training.run_args); other train flags"
" are ignored"
msgstr ""
"Cargar TrainingRunArgs desde JSON (véase mb.training.run_args); se ignoran "
"las demás opciones de train"

